{
  "headers": [
    { "source": "**/*.gz", "headers": [{ "key": "Content-Encoding", "value": "gzip" }] },
    { "source": "**/*.js.gz", "headers": [{ "key": "Content-Type", "value": "application/javascript" }] },
    { "source": "**/*.wasm.gz", "headers": [{ "key": "Content-Type", "value": "application/wasm" }] },
    { "source": "**/*.data.gz", "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }] }
  ]
}
