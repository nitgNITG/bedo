      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01_B
      value: "\u064A\u0639\u0645\u0644 \u0628\u062A\u062A\u0627\u0628\u0639 \u0645\u0633\u0628\u0642
        \u062F\u0648\u0646 \u0627\u0644\u0631\u062C\u0648\u0639 \u0625\u0644\u0649
