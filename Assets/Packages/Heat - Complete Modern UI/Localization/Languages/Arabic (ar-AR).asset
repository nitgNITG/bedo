        \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0644\u0648\u0644\u0628\u064A
        \u0627\u0644\u062A\u0646\u0627\u0633\u0628\u064A \u0639\u0646 \u0637\u0631\u064A\u0642
        \u0627\u0644\u0625\u0636\u0627\u0621\u0629 \u0639\u0646\u062F\u0645\u0627
        \u064A\u0643\u0648\u0646 \u0627\u0644\u0635\u0645\u0627\u0645 \u0645\u0641\u062A\u0648\u062D\u064B\u0627\u060C
        \u0645\u0645\u0627 \u064A\u0648\u0641\u0631 \u0645\u0624\u0634\u0631\u064B\u0627
        \u0628\u0635\u0631\u064A\u064B\u0627 \u0644\u0639\u0645\u0644\u064A\u0629
        \u0627\u0644\u0635\u0645\u0627\u0645"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pump_Indication_LED_Title
      value: "\u0645\u0624\u0634\u0631 LED \u0644\u0644\u0645\u0636\u062E\u0629"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pump_Indication_LED_Def
      value: "\u064A\u0648\u0641\u0631 \u062D\u0627\u0644\u0629 \u0645\u0631\u0626\u064A\u0629
        \u0644\u0645\u0636\u062E\u0629 \u0627\u0644\u062D\u062C\u0627\u0628 \u0627\u0644\u062D\u0627\u062C\u0632\u060C
        \u062D\u064A\u062B \u064A\u0636\u064A\u0621 \u0639\u0646\u062F\u0645\u0627
        \u062A\u0643\u0648\u0646 \u0627\u0644\u0645\u0636\u062E\u0629 \u0642\u064A\u062F
        \u0627\u0644\u062A\u0634\u063A\u064A\u0644 \u0648\u064A\u0648\u0641\u0631
        \u0645\u0644\u0627\u062D\u0638\u0627\u062A \u0639\u0645\u0644\u064A\u0629"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
  - table: {fileID: 11400000, guid: bee86a706d14d5d4ba0b88cd4d9bf00d, type: 2}
    tableContent:
    - key: Title
      value: "\u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A \u0627\u0644\u0636\u063A\u0637
        \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0648\u062D\u062F\u0629
        \u0627\u0644\u062A\u062D\u0643\u0645 PID "
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Title_Header
      value: "\u062A\u062C\u0631\u0628\u0629 1"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Instructor
      value: "\u0645\u0631\u062D\u0628\u064B\u0627! \u0641\u064A \u0647\u0630\u0647
        \u0627\u0644\u062A\u062C\u0631\u0628\u0629\u060C \u0633\u062A\u0633\u062A\u0643\u0634\u0641
        \u0643\u064A\u0641 \u064A\u062A\u062D\u0643\u0645 \u0645\u0646\u0638\u0648\u0645\u0629
        \u0627\u0644\u062A\u062D\u0643\u0645 \u0627\u0644\u062A\u0646\u0627\u0633\u0628\u064A-\u0627\u0644\u062A\u0643\u0627\u0645\u0644\u064A-\u0627\u0644\u062A\u0641\u0627\u0636\u0644\u064A
        (PID) \u0641\u064A \u0636\u063A\u0637 \u0627\u0644\u0647\u0648\u0627\u0621
        \u062F\u0627\u062E\u0644 \u0646\u0638\u0627\u0645 \u0645\u063A\u0644\u0642.
        \u0633\u062A\u0642\u0648\u0645 \u0628\u0636\u0628\u0637 \u0627\u0644\u0642\u064A\u0645
        \u0627\u0644\u062A\u0646\u0627\u0633\u0628\u064A\u0629 \u0648\u0627\u0644\u062A\u0643\u0627\u0645\u0644\u064A\u0629
        \u0648\u0627\u0644\u062A\u0641\u0627\u0636\u0644\u064A\u0629 \u0644\u0645\u0631\u0627\u0642\u0628\u0629
        \u062A\u0623\u062B\u064A\u0631\u0627\u062A\u0647\u0627 \u0639\u0644\u0649
        \u0627\u0633\u062A\u062C\u0627\u0628\u0629 \u0627\u0644\u0646\u0638\u0627\u0645
        \u0645\u062B\u0644 \u0632\u0645\u0646 \u0627\u0644\u0635\u0639\u0648\u062F
        \u0648\u0627\u0644\u062A\u062E\u0637\u064A \u0627\u0644\u0632\u0627\u0626\u062F
        \u0648\u0627\u0644\u062E\u0637\u0623 \u0641\u064A \u0627\u0644\u062D\u0627\u0644\u0629
        \u0627\u0644\u0645\u0633\u062A\u0642\u0631\u0629 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u0623\u062F\u0648\u0627\u062A \u0627\u0644\u0628\u0631\u0645\u062C\u0629
        \u0627\u0644\u0641\u0648\u0631\u064A\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Objectives
      value: "\u0641\u0647\u0645 \u062A\u0623\u062B\u064A\u0631\u0627\u062A \u0645\u0639\u0627\u0645\u0644\u0627\u062A
        \u0645\u0646\u0638\u0648\u0645 \u0627\u0644\u062A\u062D\u0643\u0645 PID (Kp,
        Ki, Kd) \u0639\u0644\u0649 \u062F\u064A\u0646\u0627\u0645\u064A\u0643\u064A\u0629
        \u0627\u0644\u062A\u062D\u0643\u0645 \u0628\u0627\u0644\u0636\u063A\u0637\u060C
        \u0648\u062A\u062D\u0642\u064A\u0642 \u0627\u0633\u062A\u062C\u0627\u0628\u0629
        \u0646\u0638\u0627\u0645 \u0645\u0633\u062A\u0642\u0631\u0629 \u0648\u062F\u0642\u064A\u0642\u0629
        \u0645\u0646 \u062E\u0644\u0627\u0644 \u0636\u0628\u0637 \u0647\u0630\u0647
        \u0627\u0644\u0642\u064A\u0645 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u0648\u0627\u062C\u0647\u0629 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062C."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pull_Emergency
      value: "\u0642\u0645 \u0628\u062A\u062D\u0631\u064A\u0631 \u0645\u0641\u062A\u0627\u062D
        \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0645\u0648\u062C\u0648\u062F
        \u0639\u0644\u0649 \u0627\u0644\u062C\u0647\u0627\u0632."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Switch_On
      value: "\u0642\u0645 \u0628\u062A\u0634\u063A\u064A\u0644 \u0645\u0641\u062A\u0627\u062D
        \u0627\u0644\u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u062E\u0627\u0635
        \u0628\u0627\u0644\u0648\u062D\u062F\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Set_Gains_01
      value: "\u0639\u064A\u0651\u0646 Kp = 120\u060C Ki = 0\u060C Kd = 0."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SetPoint_01
      value: "\u0642\u0645 \u0628\u0636\u0628\u0637 \u0627\u0644\u0636\u063A\u0637
        \u0639\u0644\u0649 0.5 \u0628\u0627\u0631."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Start_Button_01
      value: "\u0642\u0645 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
        \u0632\u0631 \"Start\" \u0644\u0628\u062F\u0621 \u062A\u0634\u063A\u064A\u0644
        \u0627\u0644\u0645\u0636\u062E\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SaveScreen_button
      value: "\u0642\u0645 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
        \"Save Screen\" \u0644\u062D\u0641\u0638 \u0645\u0646\u062D\u0646\u0649 \u0627\u0644\u0627\u0633\u062A\u062C\u0627\u0628\u0629
        \u0627\u0644\u062D\u0627\u0644\u064A."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Reset_Button_01
      value: "\u0642\u0645 \u0628\u0625\u0639\u0627\u062F\u0629 \u062A\u0639\u064A\u064A\u0646
        \u0627\u0644\u0639\u0645\u0644\u064A\u0629 \u0627\u0644\u062D\u0627\u0644\u064A\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Set_Gains_02
      value: "\u0642\u0645 \u0628\u062A\u0639\u062F\u064A\u0644 \u0642\u064A\u0645\u0629
        Ki = 35\u060C Kd = 5."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Start_Button_02
      value: "\u0642\u0645 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
        Start \u0645\u0631\u0629 \u0623\u062E\u0631\u0649."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Set_Disturbance
      value: "\u0642\u0645 \u0628\u0636\u0628\u0637 \u0627\u0644\u0645\u062D\u0628\u0633
        \u0639\u0644\u0649 30% \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0634\u0631\u064A\u0637
        \u201CDisturbance%\u201D."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Export_Button
      value: "\u0642\u0645 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
        \"Export\" \u0644\u062D\u0641\u0638 \u0627\u0644\u0628\u064A\u0627\u0646\u0627\u062A
        \u0628\u0645\u0644\u0641 \u0627\u0643\u0633\u064A\u0644."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: You_are_done
      value: "\u0644\u0642\u062F \u0627\u0646\u062A\u0647\u064A\u062A! \u064A\u0645\u0643\u0646\u0643
        \u0627\u0644\u0622\u0646 \u062A\u062D\u0644\u064A\u0644 \u0646\u062A\u0627\u0626\u062C\u0643
        \u0623\u0648 \u0627\u062E\u062A\u064A\u0627\u0631 \u062A\u062C\u0631\u0628\u0629
        \u0623\u062E\u0631\u0649."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_01
      value: "\u0631\u0627\u0642\u0628 \u0627\u0633\u062A\u062C\u0627\u0628\u0629
        \u0627\u0644\u0646\u0638\u0627\u0645 \u0639\u0644\u0649 \u0627\u0644\u0631\u0633\u0645
        \u0627\u0644\u0628\u064A\u0627\u0646\u064A. \u0644\u0627\u062D\u0638 \u0632\u0645\u0646
        \u0627\u0644\u0627\u0631\u062A\u0641\u0627\u0639\u060C \u0648\u0627\u0644\u062A\u062E\u0637\u064A\u060C
        \u0648\u0623\u064A \u062E\u0637\u0623 \u062B\u0627\u0628\u062A."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01
      value: "\u0645\u0627 \u0627\u0644\u0647\u062F\u0641 \u0627\u0644\u0631\u0626\u064A\u0633\u064A
        \u0645\u0646 \u0627\u0644\u062D\u062F \u0627\u0644\u062A\u0641\u0627\u0636\u0644\u064A
        (Kd) \u0641\u064A \u0645\u0646\u0638\u0648\u0645 PID\u061F"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01_A
      value: "\u062A\u0642\u0644\u064A\u0644 \u0627\u0644\u062A\u062E\u0637\u064A
        \u0627\u0644\u0632\u0627\u0626\u062F \u0648\u062A\u062D\u0633\u064A\u0646
        \u0627\u0644\u0627\u0633\u062A\u0642\u0631\u0627\u0631 ."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01_B
      value: "\u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u062E\u0637\u0623 \u0641\u064A
        \u0627\u0644\u062D\u0627\u0644\u0629 \u0627\u0644\u0645\u0633\u062A\u0642\u0631\u0629"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01_C
      value: "\u0632\u064A\u0627\u062F\u0629 \u0627\u0644\u0636\u0648\u0636\u0627\u0621
        \u0641\u064A \u0627\u0644\u0646\u0638\u0627\u0645"
      audioValue: {fileID: 0}
