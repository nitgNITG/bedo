  - table: {fileID: 11400000, guid: 3859838e30ed53f46b0ba9b9bc0c8274, type: 2}
    tableContent:
    - key: Title
      value: "\u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A \u0645\u0648\u0642\u0639
        \u0627\u0644\u0645\u0648\u062A\u0648\u0631 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u0648\u062D\u062F\u0629 \u0627\u0644\u062A\u062D\u0643\u0645 (PID)"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Title_Header
      value: "\u062A\u062C\u0631\u0628\u0629 1"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Instructor
      value: "\u0645\u0631\u062D\u0628\u064B\u0627! \u0641\u064A \u0647\u0630\u0647
        \u0627\u0644\u062A\u062C\u0631\u0628\u0629\u060C \u0633\u062A\u062A\u0639\u0644\u0645
        \u0643\u064A\u0641\u064A\u0629 \u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A
        \u0645\u0648\u0642\u0639 \u0645\u062D\u0631\u0643 \u062A\u064A\u0627\u0631
        \u0645\u0633\u062A\u0645\u0631 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u0648\u062D\u062F\u0629 \u062A\u062D\u0643\u0645 PID. \u0633\u062A\u0641\u062A\u062D
        \u062A\u0623\u062B\u064A\u0631\u0627\u062A \u0627\u0644\u0643\u0633\u0628
        \u0627\u0644\u062A\u0646\u0627\u0633\u0628\u064A (Kp)\u060C \u0648\u0627\u0644\u0643\u0633\u0628
        \u0627\u0644\u062A\u0643\u0627\u0645\u0644\u064A (Ki)\u060C \u0648\u0627\u0644\u0643\u0633\u0628
        \u0627\u0644\u062A\u0641\u0627\u0636\u0644\u064A (Kd) \u0639\u0644\u0649
        \u0627\u0633\u062A\u062C\u0627\u0628\u0629 \u0627\u0644\u0646\u0638\u0627\u0645."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Objectives
      value: "\u062A\u0647\u062F\u0641 \u0647\u0630\u0647 \u0627\u0644\u062A\u062C\u0631\u0628\u0629
        \u0625\u0644\u0649 \u0641\u0647\u0645 \u0645\u0628\u0627\u062F\u0626 \u0627\u0644\u062A\u062D\u0643\u0645
        \u0628\u0627\u0644\u0640 PID \u0645\u0646 \u062E\u0644\u0627\u0644 \u062A\u0639\u062F\u064A\u0644
        \u0645\u0639\u0627\u0645\u0644\u0627\u062A\u0647 \u0627\u0644\u062B\u0644\u0627\u062B\u0629
        (Kp, Ki, Kd). \u0633\u062A\u0642\u0648\u0645 \u0628\u062F\u0631\u0627\u0633\u0629
        \u062A\u0623\u062B\u064A\u0631 \u0643\u0644 \u0645\u0639\u0627\u0645\u0644
        \u0639\u0644\u0649 \u0623\u062F\u0627\u0621 \u0627\u0644\u0646\u0638\u0627\u0645."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
