  - table: {fileID: 11400000, guid: 536dfdbbddcc1ac4a859c8af22addfc8, type: 2}
    tableContent:
    - key: Title
      value: "\u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A \u0627\u0644\u062A\u062F\u0641\u0642
        \u0641\u064A \u062D\u0644\u0642\u0629 \u0645\u0641\u062A\u0648\u062D\u0629\r\n(\u0627\u0644\u0648\u0636\u0639
        \u0627\u0644\u064A\u062F\u0648\u064A)\r\n"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Title_Header
      value: "\u062A\u062C\u0631\u0628\u0629 2"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Instructor
      value: "\u0645\u0631\u062D\u0628\u0627\u064B! \u0641\u064A \u0647\u0630\u0647
        \u0627\u0644\u062A\u062C\u0631\u0628\u0629\u060C \u0633\u062A\u0633\u062A\u0643\u0634\u0641
        \u0643\u064A\u0641 \u062A\u0639\u0645\u0644 \u0623\u0646\u0638\u0645\u0629
        \u0627\u0644\u062A\u062D\u0643\u0645 \u0627\u0644\u062D\u0644\u0642\u064A
        \u0627\u0644\u0645\u0641\u062A\u0648\u062D \u062F\u0648\u0646 \u0648\u062C\u0648\u062F
        \u062A\u063A\u0630\u064A\u0629 \u0631\u0627\u062C\u0639\u0629. \u0633\u062A\u062A\u062D\u0643\u0645
        \u064A\u062F\u0648\u064A\u0627\u064B \u0641\u064A \u0637\u0627\u0642\u0629
        \u0627\u0644\u0645\u0636\u062E\u0629 \u0648\u0633\u062A\u0644\u0627\u062D\u0638
        \u0643\u064A\u0641 \u064A\u0633\u062A\u062C\u064A\u0628 \u0645\u0639\u062F\u0644
        \u0627\u0644\u062A\u062F\u0641\u0642 \u0645\u0628\u0627\u0634\u0631\u0629
        \u0644\u0645\u062F\u062E\u0644\u0627\u062A\u0643\u060C \u062F\u0648\u0646
        \u0623\u064A \u062A\u0635\u062D\u064A\u062D \u062A\u0644\u0642\u0627\u0626\u064A.
        \u0633\u064A\u0633\u0627\u0639\u062F\u0643 \u0630\u0644\u0643 \u0639\u0644\u0649
        \u0641\u0647\u0645 \u0645\u062D\u062F\u062F\u0627\u062A \u0627\u0644\u062A\u062D\u0643\u0645
        \u0627\u0644\u062D\u0644\u0642\u064A \u0627\u0644\u0645\u0641\u062A\u0648\u062D
        \u0641\u064A \u0627\u0644\u062A\u0637\u0628\u064A\u0642\u0627\u062A \u0627\u0644\u0639\u0645\u0644\u064A\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Objectives
      value: "\u062A\u0647\u062F\u0641 \u0647\u0630\u0647 \u0627\u0644\u062A\u062C\u0631\u0628\u0629
        \u0625\u0644\u0649 \u062A\u0648\u0636\u064A\u062D \u0633\u0644\u0648\u0643
        \u0646\u0638\u0627\u0645 \u0627\u0644\u062A\u062D\u0643\u0645 \u0627\u0644\u062D\u0644\u0642\u064A
        \u0627\u0644\u0645\u0641\u062A\u0648\u062D \u0641\u064A \u0639\u0645\u0644\u064A\u0629
        \u0627\u0644\u062A\u062F\u0641\u0642. \u0648 \u0645\u0644\u0627\u062D\u0638\u0629
        \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629
        \u0628\u064A\u0646 \u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0636\u062E\u0629
        \u0648\u0645\u0639\u062F\u0644 \u0627\u0644\u062A\u062F\u0641\u0642. \u0648
        \u0641\u0647\u0645 \u0633\u0628\u0628 \u0639\u062F\u0645 \u0642\u062F\u0631\u0629
        \u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u062D\u0644\u0642\u0629 \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629
        \u0639\u0644\u0649 \u0627\u0644\u062A\u0635\u062D\u064A\u062D \u062A\u062C\u0627\u0647
        \u0627\u0644\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062A ."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pull_Emergency
      value: "\u062D\u0631\u0631 \u0632\u0631 \u0627\u0644\u0625\u064A\u0642\u0627\u0641
        \u0627\u0644\u0637\u0627\u0631\u0626."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Switch_On
      value: "\u0634\u063A\u0651\u0644 \u0645\u0641\u062A\u0627\u062D \u0627\u0644\u0637\u0627\u0642\u0629
        \u0627\u0644\u0631\u0626\u064A\u0633\u064A \u0644\u0644\u0648\u062D\u062F\u0629"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Manual_Mode_Button
      value: "\u0642\u0645 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
        \u0632\u0631 \"Open-Loop Mode\u201D \u0644\u062A\u0639\u0637\u064A\u0644
        PID \u0648\u0627\u0644\u062F\u062E\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u062A\u062D\u0643\u0645
        \u0628\u0627\u0644\u062D\u0644\u0642\u0629 \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Use_PumpAndFlow_Mode
      value: "\u0642\u0645 \u0628\u062A\u0641\u0639\u064A\u0644 \u0627\u0644\u0645\u0641\u062A\u0627\u062D
        \u0641\u064A \u0627\u062A\u062C\u0627\u0647 \u0645\u0639\u062F\u0644 \u0627\u0644\u062A\u062F\u0641\u0642"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SetFlow_01
      value: "\u0642\u0645 \u0628\u0636\u0628\u0637 \u0645\u0639\u062F\u0644 \u0627\u0644\u062A\u062F\u0641\u0642
        \u0639\u0644\u0649 100 l/h."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Set_Pump_01
      value: "\u0642\u0645 \u0628\u0636\u0628\u0637 \u0634\u0631\u064A\u062D\u0629
        \u0627\u0644\u0645\u0636\u062E\u0629 \u0639\u0644\u0649 60%."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Start_Button_01
      value: "\u0642\u0645 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
        \u0632\u0631 \"Start\" \u0644\u0628\u062F\u0621 \u062A\u0634\u063A\u064A\u0644
        \u0627\u0644\u0645\u0636\u062E\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Stop_Button_01
      value: "\u0642\u0645 \u0628\u0625\u0639\u0627\u062F\u0629 \u062A\u0639\u064A\u064A\u0646
        \u0627\u0644\u0639\u0645\u0644\u064A\u0629 \u0627\u0644\u062D\u0627\u0644\u064A\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Use_PumpOnly_Mode
      value: "\u0642\u0645 \u0628\u062A\u0641\u0639\u064A\u0644 \u0627\u0644\u0645\u0641\u062A\u0627\u062D
        \u0641\u064A \u0627\u062A\u062C\u0627\u0647 \u0642\u062F\u0631\u0629 \u062A\u0634\u063A\u064A\u0644
