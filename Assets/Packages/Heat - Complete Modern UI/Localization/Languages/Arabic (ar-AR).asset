    - key: Pop_up_Quiz_01_C
      value: "\u0625\u0646\u062A\u0627\u062C \u0645\u062E\u0631\u062C\u0627\u062A
        \u0645\u062A\u0646\u0627\u0633\u0628\u0629 \u0645\u0639 \u0627\u0644\u062E\u0637\u0623
