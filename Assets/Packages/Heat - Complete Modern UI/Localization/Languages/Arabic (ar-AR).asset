      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01_C
      value: "\u064A\u062A\u0637\u0644\u0628 \u062A\u062F\u062E\u0644\u0627\u064B
        \u0628\u0634\u0631\u064A\u0627\u064B \u0645\u0633\u062A\u0645\u0631\u0627\u064B
        \u0644\u0643\u0644 \u0639\u0645\u0644\u064A\u0629"
