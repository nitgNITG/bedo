      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Instructor
      value: "\u0645\u0631\u062D\u0628\u064B\u0627! \u0641\u064A \u0647\u0630\u0647
        \u0627\u0644\u062A\u062C\u0631\u0628\u0629\u060C \u0633\u062A\u062A\u062D\u0643\u0645
        \u064A\u062F\u0648\u064A\u064B\u0627 \u0641\u064A \u0645\u0633\u062A\u0648\u0649
        \u0627\u0644\u0645\u0627\u0621 \u0641\u064A \u0627\u0644\u062E\u0632\u0627\u0646
        \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0627\u0644\u062A\u062D\u0643\u0645
        \u0628\u0627\u0644\u062D\u0644\u0642\u0629 \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629
        \u0623\u064A \u062F\u0648\u0646 \u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u0623\u064A \u062A\u063A\u0630\u064A\u0629 \u0631\u0627\u062C\u0639\u0629
        \u0623\u0648 \u062A\u0635\u062D\u064A\u062D \u0622\u0644\u064A. \u0633\u062A\u0642\u0648\u0645
        \u0628\u062A\u0639\u064A\u064A\u0646 \u0633\u0631\u0639\u0629 \u0627\u0644\u0645\u0636\u062E\u0629
        \u0648\u0645\u0648\u0636\u0639 \u0627\u0644\u0635\u0645\u0627\u0645 \u064A\u062F\u0648\u064A\u064B\u0627
        \u0644\u0644\u062A\u0623\u062B\u064A\u0631 \u0639\u0644\u0649 \u0645\u0633\u062A\u0648\u0649
        \u0627\u0644\u0633\u0627\u0626\u0644\u060C \u0648\u0633\u062A\u0631\u0627\u0642\u0628
        \u0627\u0633\u062A\u062C\u0627\u0628\u0629 \u0627\u0644\u0646\u0638\u0627\u0645
        \u062F\u0648\u0646 \u062A\u062F\u062E\u0644 PID."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Objectives
      value: "\u062A\u0647\u062F\u0641 \u0647\u0630\u0647 \u0627\u0644\u062A\u062C\u0631\u0628\u0629
        \u0627\u0644\u0649 \u0627\u0644\u062A\u062D\u0643\u0645 \u064A\u062F\u0648\u064A\u064B\u0627
        \u0641\u064A \u0645\u0633\u062A\u0648\u0649 \u0627\u0644\u0645\u0627\u0621
        \u0645\u0646 \u062E\u0644\u0627\u0644 \u0636\u0628\u0637 \u0625\u0639\u062F\u0627\u062F\u0627\u062A
        \u0627\u0644\u0645\u0636\u062E\u0629 \u0648\u0627\u0644\u0635\u0645\u0627\u0645
        \u0641\u064A \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u060C
        \u0648\u0645\u0631\u0627\u0642\u0628\u0629 \u0633\u0644\u0648\u0643 \u0627\u0644\u0646\u0638\u0627\u0645\u060C
        \u0648\u0641\u0647\u0645 \u0642\u064A\u0648\u062F \u0627\u0644\u062A\u062D\u0643\u0645
        \u0628\u0627\u0644\u062D\u0644\u0642\u0629 \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629
        \u0645\u062B\u0644 \u0627\u0644\u062D\u0633\u0627\u0633\u064A\u0629 \u062A\u062C\u0627\u0647
        \u0627\u0644\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062A \u0648\u0639\u062F\u0645
        \u0627\u0644\u0642\u062F\u0631\u0629 \u0639\u0644\u0649 \u062A\u0635\u062D\u064A\u062D
        \u0627\u0644\u0623\u062E\u0637\u0627\u0621 \u0627\u0644\u062B\u0627\u0628\u062A\u0629."
