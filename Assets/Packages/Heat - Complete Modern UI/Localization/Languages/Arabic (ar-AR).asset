      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_C
      value: "\u0644\u0627 \u064A\u0624\u062B\u0631 \u0627\u0644\u0645\u062E\u0631\u062C
        \u0639\u0644\u0649 \u0625\u062C\u0631\u0627\u0621 \u0627\u0644\u062A\u062D\u0643\u0645
        (\u0644\u0627 \u062A\u0648\u062C\u062F \u062A\u063A\u0630\u064A\u0629 \u0631\u0627\u062C\u0639\u0629). "
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_03
      value: "\u064A\u0639\u062A\u0645\u062F \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639
        \u0639\u0644\u0649 \u062A\u062D\u062F\u064A\u062F \u0633\u0631\u0639\u0629
        \u0627\u0644\u0645\u062D\u0631\u0643 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0637\u0631\u0629\u060C
        \u0648\u0630\u0644\u0643 \u0645\u0646 \u062E\u0644\u0627\u0644 \u062A\u062B\u0628\u064A\u062A
        \u0642\u064A\u0645\u0629 \u0627\u0644\u062C\u0647\u062F \u062B\u0645 \u062D\u0633\u0627\u0628
        \u0627\u0644\u0632\u0645\u0646 \u0627\u0644\u0644\u0627\u0632\u0645 \u0644\u0648\u0635\u0648\u0644
        \u0627\u0644\u0645\u062D\u0631\u0643 \u0625\u0644\u0649 \u0627\u0644\u0633\u0631\u0639\u0629
        \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629. \u0628\u0639\u062F \u0630\u0644\u0643
        \u064A\u062A\u0645 \u0641\u0635\u0644 \u0627\u0644\u062C\u0647\u062F \u0639\u0646\u062F
        \u0627\u0646\u062A\u0647\u0627\u0621 \u0647\u0630\u0627 \u0627\u0644\u0632\u0645\u0646\u060C
        \u062B\u0645 \u0645\u0644\u0627\u062D\u0638\u0629 \u0627\u0644\u0633\u0631\u0639\u0629
        \u0627\u0644\u0646\u0647\u0627\u0626\u064A\u0629 \u0627\u0644\u062A\u064A
        \u0648\u0635\u0644 \u0625\u0644\u064A\u0647\u0627 \u0627\u0644\u0645\u062D\u0631\u0643."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_04
      value: "\u0642\u0645 \u0628\u0627\u062E\u062A\u064A\u0627\u0631 \u0647\u0630\u0627
        \u0627\u0644\u0648\u0636\u0639 \u0639\u0646\u062F\u0645\u0627 \u062A\u0631\u064A\u062F
        \u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u0645\u062D\u0631\u0643 \u0628\u062A\u062D\u062F\u064A\u062F
        \u0641\u0631\u0642 \u0627\u0644\u062C\u0647\u062F \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u060C
        \u0648\u0644\u064A\u0633 \u0645\u0646 \u062E\u0644\u0627\u0644 \u062A\u062D\u062F\u064A\u062F
        \u0627\u0644\u0633\u0631\u0639\u0629 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0637\u0631\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
  - table: {fileID: 11400000, guid: 93e2af971aa79d04598466361dc9472b, type: 2}
    tableContent:
    - key: Emergency_Switch_Title
      value: "\u0632\u0631 \u0627\u0644\u0637\u0648\u0627\u0631\u0626"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Emergency_Switch_Def
      value: "\u0632\u0631 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0647\u0648
        \u0645\u064A\u0632\u0629 \u0623\u0645\u0627\u0646 \u062A\u0642\u0648\u0645
        \u0628\u0641\u0635\u0644 \u0627\u0644\u0637\u0627\u0642\u0629 \u0639\u0646
        \u0627\u0644\u0646\u0638\u0627\u0645 \u0628\u0627\u0644\u0643\u0627\u0645\u0644
        \u0639\u0644\u0649 \u0627\u0644\u0641\u0648\u0631\u060C \u0645\u0645\u0627
        \u064A\u0648\u0642\u0641 \u062C\u0645\u064A\u0639 \u0627\u0644\u0639\u0645\u0644\u064A\u0627\u062A
        \u0641\u064A \u062D\u0627\u0644\u0629 \u0627\u0644\u0637\u0648\u0627\u0631\u0626"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ON_OFF_Button_Title
      value: "\u0645\u0641\u062A\u0627\u062D \u062A\u0634\u063A\u064A\u0644/\u0625\u064A\u0642\u0627\u0641
        \u0627\u0644\u0645\u0639\u0645\u0644"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ON_OFF_Button_Def
      value: "\u064A\u062A\u062D\u0643\u0645 \u0641\u064A \u0627\u0644\u0637\u0627\u0642\u0629
        \u0644\u062C\u0645\u064A\u0639 \u0623\u062C\u0632\u0627\u0621 \u0646\u0638\u0627\u0645
        \u0645\u062F\u0631\u0628 \u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A
        \u0627\u0644\u0636\u063A\u0637\u060C \u0645\u0645\u0627 \u064A\u0633\u0645\u062D
        \u0628\u062A\u0634\u063A\u064A\u0644\u0647 \u0623\u0648 \u0625\u064A\u0642\u0627\u0641\u0647
        \u0645\u0646 \u0623\u062C\u0644 \u0627\u0644\u062A\u0634\u063A\u064A\u0644
        \u0648\u0627\u0644\u0633\u0644\u0627\u0645\u0629"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Diaphragm_Pump_Title
      value: "\u0645\u0636\u062E\u0629 \u0627\u0644\u062D\u062C\u0627\u0628 \u0627\u0644\u062D\u0627\u062C\u0632"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Diaphragm_Pump_Def
      value: "\u062A\u0648\u0641\u0651\u0631 \u062E\u062A\u0645\u064B\u0627 \u0645\u062D\u0643\u0645\u064B\u0627
        \u0628\u064A\u0646 \u0622\u0644\u064A\u0629 \u0627\u0644\u0642\u064A\u0627\u062F\u0629
        \u0648\u062D\u062C\u0631\u0629 \u0627\u0644\u0636\u063A\u0637\u060C \u0645\u0645\u0627
        \u064A\u0633\u0645\u062D \u0644\u0644\u0645\u0636\u062E\u0629 \u0628\u0646\u0642\u0644
        \u0648\u0636\u063A\u0637 \u0648\u0625\u062E\u0644\u0627\u0621 \u0627\u0644\u0648\u0633\u0637
        \u062F\u0648\u0646 \u0627\u0644\u062D\u0627\u062C\u0629 \u0625\u0644\u0649
        \u0645\u0648\u0627\u062F \u062A\u0634\u062D\u064A\u0645. \u064A\u0645\u0643\u0646
        \u0644\u0645\u0636\u062E\u0629 \u0627\u0644\u062D\u062C\u0627\u0628 \u0627\u0644\u062D\u0627\u062C\u0632
        \u0623\u0646 \u062A\u0646\u062A\u062C \u0636\u063A\u0637 \u062A\u0635\u0631\u064A\u0641
        \u064A\u0635\u0644 \u0625\u0644\u0649 1200 \u0628\u0627\u0631"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pressure_Vessel_Title
      value: "\u0648\u0639\u0627\u0621 \u0627\u0644\u0636\u063A\u0637"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pressure_Vessel_Def
      value: "\u0648\u0639\u0627\u0621 \u0627\u0644\u0636\u063A\u0637 \u064A\u062D\u062A\u0641\u0638
        \u0628\u0627\u0644\u0648\u0633\u0637 (\u0645\u062B\u0644 \u0627\u0644\u0647\u0648\u0627\u0621
        \u0623\u0648 \u0627\u0644\u0645\u0627\u0621) \u062A\u062D\u062A \u0636\u063A\u0637
        \u0645\u0636\u0628\u0648\u0637. \u064A\u064F\u0633\u062A\u062E\u062F\u0645
        \u0644\u062A\u062E\u0632\u064A\u0646 \u0627\u0644\u0648\u0633\u0637 \u0645\u0639
        \u0627\u0644\u062D\u0641\u0627\u0638 \u0639\u0644\u0649 \u0636\u063A\u0637
        \u0645\u0633\u062A\u0642\u0631 \u0644\u0644\u0627\u062E\u062A\u0628\u0627\u0631
        \u0623\u0648 \u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A \u0627\u0644\u0639\u0645\u0644\u064A\u0627\u062A."
