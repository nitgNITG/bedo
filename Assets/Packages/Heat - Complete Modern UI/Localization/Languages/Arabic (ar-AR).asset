      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02
      value: "\u0641\u064A \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u064A\u062F\u0648\u064A
        (\u0627\u0644\u062D\u0644\u0642\u0629 \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629)\u060C
        \u0645\u0627\u0630\u0627 \u064A\u062D\u062F\u062B \u0625\u0630\u0627 \u0648\u0627\u062C\u0647
        \u0627\u0644\u0645\u062D\u0631\u0643 \u062D\u0645\u0644\u0627\u064B \u063A\u064A\u0631
        \u0645\u062A\u0648\u0642\u0639 \u0623\u0648 \u0627\u062D\u062A\u0643\u0627\u0643\u064B\u0627\u061F"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_A
      value: "\u064A\u0632\u064A\u062F \u0627\u0644\u0646\u0638\u0627\u0645 \u062A\u0644\u0642\u0627\u0626\u064A\u064B\u0627
        \u0645\u0646 \u0627\u0644\u0642\u062F\u0631\u0629 \u0644\u0644\u062D\u0641\u0627\u0638
        \u0639\u0644\u0649 \u0627\u0644\u0645\u0648\u0636\u0639 \u0627\u0644\u0645\u062D\u062F\u062F."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_B
      value: "\u0642\u062F \u064A\u0646\u062D\u0631\u0641 \u0645\u0648\u0636\u0639
        \u0627\u0644\u0645\u062D\u0631\u0643 \u0648\u0644\u0646 \u064A\u062A\u0645
        \u062A\u0635\u062D\u064A\u062D\u0647 \u062A\u0644\u0642\u0627\u0626\u064A\u064B\u0627."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_C
      value: "\u0633\u064A\u064F\u0641\u0639\u0651\u0644 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062C
