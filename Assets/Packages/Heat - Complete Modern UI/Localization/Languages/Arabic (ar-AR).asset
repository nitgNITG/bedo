      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Move_Slider_10
      value: "\u062D\u0631\u0643 \u0627\u0644\u0634\u0631\u064A\u062D\u0629 \u0644\u062A\u0639\u064A\u064A\u0646
