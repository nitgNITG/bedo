        \u0627\u0644\u062A\u062C\u0631\u064A\u0628\u064A \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u0645\u0641\u062A\u0627\u062D \u0627\u0644\u062A\u0634\u063A\u064A\u0644/\u0627\u0644\u0625\u064A\u0642\u0627\u0641."
