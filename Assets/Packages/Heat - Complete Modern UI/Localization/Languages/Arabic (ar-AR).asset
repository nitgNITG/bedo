      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Proportional_Valve_Def
      value: "\u064A\u063A\u064A\u0651\u0631 \u0641\u062A\u062D\u0629 \u0627\u0644\u0645\u0645\u0631
        \u0643\u0647\u0631\u0628\u0627\u0626\u064A\u064B\u0627 \u0644\u0644\u062A\u062D\u0643\u0645
        \u0641\u064A \u0627\u0644\u062A\u062F\u0641\u0642 \u0623\u0648 \u0627\u0644\u0636\u063A\u0637."
