      spriteValue: {fileID: 0}
  - table: {fileID: 11400000, guid: 324c2c63599c8d2418e0082e139b32e5, type: 2}
    tableContent:
    - key: Title
      value: "\u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A \u0633\u0631\u0639\u0629
        \u0645\u062D\u0631\u0643 \u0627\u0644\u062A\u064A\u0627\u0631 \u0627\u0644\u0645\u0633\u062A\u0645\u0631
        \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0648\u062D\u062F\u0629
        PID"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Title_Header
      value: "\u0627\u0644\u062A\u062C\u0631\u0628\u0629 1"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Instructor
      value: "\u0645\u0631\u062D\u0628\u064B\u0627! \u0641\u064A \u0647\u0630\u0647
        \u0627\u0644\u062A\u062C\u0631\u0628\u0629\u060C \u0633\u062A\u062A\u0639\u0644\u0645
        \u0643\u064A\u0641\u064A\u0629 \u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A
        \u0633\u0631\u0639\u0629 \u0645\u062D\u0631\u0643 \u062A\u064A\u0627\u0631
        \u0645\u0633\u062A\u0645\u0631 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u0648\u062D\u062F\u0629 \u062A\u062D\u0643\u0645 PID. \u0633\u062A\u062E\u062A\u0628\u0631
        \u062A\u0623\u062B\u064A\u0631\u0627\u062A \u0627\u0644\u0643\u0633\u0628
        \u0627\u0644\u062A\u0646\u0627\u0633\u0628\u064A (Kp)\u060C \u0648\u0627\u0644\u062A\u0643\u0627\u0645\u0644\u064A
        (Ki)\u060C \u0648\u0627\u0644\u062A\u0641\u0627\u0636\u0644\u064A (Kd)\u060C
        \u0648\u062A\u0637\u0628\u0642 \u0627\u0636\u0637\u0631\u0627\u0628\u064B\u0627
        (\u062D\u0645\u0644\u064B\u0627) \u0644\u0641\u062D\u0635 \u0642\u062F\u0631\u0629
        \u0627\u0644\u0646\u0638\u0627\u0645 \u0639\u0644\u0649 \u0645\u0642\u0627\u0648\u0645\u062A\u0647
        \u0648\u0627\u0644\u062D\u0641\u0627\u0638 \u0639\u0644\u0649 \u0646\u0642\u0637\u0629
        \u0627\u0644\u0636\u0628\u0637."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Objectives
      value: "\u062A\u0647\u062F\u0641 \u0647\u0630\u0647 \u0627\u0644\u062A\u062C\u0631\u0628\u0629
        \u0625\u0644\u0649 \u0641\u0647\u0645 \u0627\u0644\u062A\u062D\u0643\u0645
        \u0628\u0627\u0644\u0640 PID \u0645\u0646 \u062E\u0644\u0627\u0644 \u0636\u0628\u0637
        \u0645\u0639\u0627\u0645\u0644\u0627\u062A Kp \u0648Ki \u0648Kd \u0644\u062A\u062D\u0633\u064A\u0646
        \u0627\u0633\u062A\u062C\u0627\u0628\u0629 \u0627\u0644\u0633\u0631\u0639\u0629\u060C
        \u0648\u0627\u0644\u0642\u0636\u0627\u0621 \u0639\u0644\u0649 \u0627\u0644\u062E\u0637\u0623
        \u0627\u0644\u062B\u0627\u0628\u062A\u060C \u0648\u0631\u0641\u0636 \u0627\u0644\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062A."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pull_Emergency
      value: "\u0642\u0645 \u0628\u0625\u0637\u0644\u0627\u0642 \u0645\u0641\u062A\u0627\u062D
        \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0645\u0648\u062C\u0648\u062F
        \u0639\u0644\u0649 \u0627\u0644\u062C\u0647\u0627\u0632."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Switch_On
      value: "\u0634\u063A\u0651\u0644 \u0645\u0641\u062A\u0627\u062D \u0627\u0644\u062A\u0634\u063A\u064A\u0644/\u0627\u0644\u0625\u064A\u0642\u0627\u0641."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Set_Gains_01
      value: "\u0639\u064A\u0651\u0646 Kp = 0.001\u060C Ki = 500\u060C Kd = 0."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SetPoint_01
      value: "\u0627\u0636\u0628\u0637 \u0627\u0644\u0633\u0631\u0639\u0629 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629
        (\u0646\u0642\u0637\u0629 \u0627\u0644\u0636\u0628\u0637) \u0639\u0644\u0649
        1500 \u062F\u0648\u0631\u0629/\u062F\u0642\u064A\u0642\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Start_Button_01
      value: "\u0627\u0646\u0642\u0631 \u0639\u0644\u0649 \u0632\u0631 \"Start\"
        \u0644\u0628\u062F\u0621 \u062D\u0631\u0643\u0629 \u0627\u0644\u0645\u062D\u0631\u0643."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Set_Disturbance
