      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SetValve_60
      value: "\u0642\u0645 \u0628\u0632\u064A\u0627\u062F\u0629 \u0641\u062A\u062D\u0629
        \u0627\u0644\u0635\u0645\u0627\u0645 \u064A\u062F\u0648\u064A\u064B\u0627
        \u0625\u0644\u0649 50% \u0644\u0645\u062D\u0627\u0643\u0627\u0629 \u0627\u0636\u0637\u0631\u0627\u0628"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Reset_Button_01
      value: "\u0627\u0639\u0627\u062F\u0629 \u0627\u0644\u062A\u0634\u063A\u064A\u0644
