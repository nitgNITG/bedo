      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Motor_Indication_LED_Title
      value: "\u0645\u0624\u0634\u0631 \u0644\u0644\u0645\u062A\u0648\u0631 LED"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Motor_Indication_LED_Def
      value: "\u0645\u0624\u0634\u0631 LED \u0644\u0644\u0645\u062D\u0631\u0643 \u064A\u0648\u0636\u062D
        \u062D\u0627\u0644\u0629 \u0627\u0644\u0645\u062D\u0631\u0643 \u0628\u0627\u0644\u0623\u0644\u0648\u0627\u0646
        \u0623\u0648 \u0627\u0644\u0648\u0645\u064A\u0636."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Generator_Indication_LED_Title
      value: " \u0645\u0624\u0634\u0631 \u0644\u0644\u0645\u0648\u0644\u0651\u062F
        LED"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Generator_Indication_LED_Def
      value: "\u0645\u0624\u0634\u0631 LED \u0644\u0644\u0645\u0648\u0644\u0651\u062F
        \u064A\u0628\u064A\u0646 \u062D\u0627\u0644\u0629 \u0627\u0644\u0645\u0648\u0644\u062F
        \u0645\u062B\u0644 \u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u062D\u0645\u0644
