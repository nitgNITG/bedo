        \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u064A\u062F\u0648\u064A\u061F"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01_A
      value: "\u064A\u0633\u062A\u062E\u062F\u0645 \u062A\u063A\u0630\u064A\u0629
