    - key: Switch_To_Voltage
      value: "\u0642\u0645 \u0628\u062A\u0641\u0639\u064A\u0644 \u0627\u0644\u0645\u0641\u062A\u0627\u062D
        \u0641\u064A \u0627\u062A\u062C\u0627\u0647 \u0627\u0644\u062C\u0647\u062F
        \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064A."
      audioValue: {fileID: 0}
