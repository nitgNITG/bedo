        \u0627\u0644\u0646\u0638\u0627\u0645."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_01
      value: "\u0631\u0627\u0642\u0628 \u0645\u0648\u0636\u0639 \u0627\u0644\u0645\u0646\u0632\u0644\u0642
        \u0639\u0644\u0649 \u0627\u0644\u0645\u0642\u064A\u0627\u0633. \u0644\u0627\u062D\u0638
        \u0623\u0646 \u0627\u0644\u0646\u0638\u0627\u0645 \u0644\u0627 \u064A\u0642\u0648\u0645
        \u0628\u062A\u0635\u062D\u064A\u062D \u0645\u0648\u0636\u0639\u0647 \u062A\u0644\u0642\u0627\u0626\u064A\u064B\u0627."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pause_Button
      value: "\u0623\u0648\u0642\u0641 \u0627\u0644\u062A\u0634\u063A\u064A\u0644."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pause_Voltage
      value: "\u0623\u0648\u0642\u0641 \u062C\u0647\u062F \u0627\u0644\u062F\u062E\u0644
        \u0645\u0624\u0642\u062A\u0627\u064B \u0628\u0627\u0644\u0636\u063A\u0637
        \u0639\u0644\u0649 \u0632\u0631 \u0627\u0644\u0625\u064A\u0642\u0627\u0641
        \u0627\u0644\u0645\u0624\u0642\u062A (Pause) \u0627\u0644\u0645\u0648\u062C\u0648\u062F
        \u0628\u062C\u0627\u0646\u0628 \u062D\u0642\u0644 \u0625\u062F\u062E\u0627\u0644
        \u0627\u0644\u062C\u0647\u062F."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_02
      value: "\u064A\u0639\u062A\u0645\u062F \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639
        \u0639\u0644\u0649 \u062A\u062D\u062F\u064A\u062F \u0645\u0648\u0636\u0639
        \u0627\u0644\u0645\u062D\u0631\u0643 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0637\u0631\u0629\u060C
        \u0648\u0630\u0644\u0643 \u0645\u0646 \u062E\u0644\u0627\u0644 \u062A\u062B\u0628\u064A\u062A
        \u0642\u064A\u0645\u0629 \u0627\u0644\u062C\u0647\u062F \u062B\u0645 \u062D\u0633\u0627\u0628
        \u0627\u0644\u0632\u0645\u0646 \u0627\u0644\u0644\u0627\u0632\u0645 \u0644\u0648\u0635\u0648\u0644
        \u0627\u0644\u0645\u062D\u0631\u0643 \u0625\u0644\u0649 \u0627\u0644\u0646\u0642\u0637\u0629
        \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629. \u0628\u0639\u062F \u0630\u0644\u0643
        \u064A\u062A\u0645 \u0641\u0635\u0644 \u0627\u0644\u062C\u0647\u062F \u0639\u0646\u062F
        \u0627\u0646\u062A\u0647\u0627\u0621 \u0647\u0630\u0627 \u0627\u0644\u0632\u0645\u0646\u060C
        \u062B\u0645 \u0645\u0644\u0627\u062D\u0638\u0629 \u0627\u0644\u0645\u0648\u0636\u0639
        \u0627\u0644\u0646\u0647\u0627\u0626\u064A \u0627\u0644\u0630\u064A \u0648\u0635\u0644
        \u0625\u0644\u064A\u0647 \u0627\u0644\u0645\u062D\u0631\u0643."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_03
      value: "\u0642\u0645 \u0628\u0627\u062E\u062A\u064A\u0627\u0631 \u0647\u0630\u0627
        \u0627\u0644\u0648\u0636\u0639 \u0639\u0646\u062F\u0645\u0627 \u062A\u0631\u064A\u062F
        \u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u0645\u062D\u0631\u0643 \u0628\u062A\u062D\u062F\u064A\u062F
        \u0641\u0631\u0642 \u0627\u0644\u062C\u0647\u062F \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u060C
        \u0648\u0644\u064A\u0633 \u0645\u0646 \u062E\u0644\u0627\u0644 \u062A\u062D\u062F\u064A\u062F
        \u0645\u0648\u0636\u0639 \u0627\u0644\u0645\u0633\u0637\u0631\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
  - table: {fileID: 11400000, guid: a6d180dd5ebbdbb4db506ef461775b09, type: 2}
    tableContent:
    - key: Moving_Slider_Def
      value: "\u0627\u0644\u0645\u0632\u0644\u0651\u0650\u0642 \u0627\u0644\u0645\u062A\u062D\u0631\u0643
        \u0639\u0631\u0628\u0629 \u062A\u062A\u062D\u0631\u0643 \u0639\u0644\u0649
        \u0627\u0644\u062F\u0644\u064A\u0644 \u0644\u062A\u064F\u0638\u0647\u0631
        \u0623\u0648 \u062A\u0636\u0628\u0637 \u0627\u0644\u0645\u0648\u0636\u0639.
        \u064A\u0642\u0648\u062F\u0647\u0627 \u0627\u0644\u0645\u062D\u0631\u0651\u0643
        \u0648\u062A\u0644\u0627\u0645\u0633 \u062D\u0633\u0627\u0633\u0627\u062A
        \u0627\u0644\u0645\u0648\u0636\u0639 \u0623\u0648 \u0627\u0644\u062D\u062F."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ON_OFF_Button_Def
      value: "\u0632\u0631 \u0627\u0644\u062A\u0634\u063A\u064A\u0644/\u0627\u0644\u0625\u064A\u0642\u0627\u0641
        \u0632\u0631 \u062A\u062D\u0643\u0645 \u064A\u064F\u0641\u0639\u0651\u0644
        \u0623\u0648 \u064A\u0639\u0637\u0651\u0644 \u062F\u0627\u0626\u0631\u0629
        \u0627\u0644\u062A\u062D\u0643\u0645 \u0628\u0627\u0644\u0645\u062D\u0631\u0651\u0643."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Motor_Indication_LED_Def
      value: "\u0645\u0624\u0634\u0651\u0631 LED \u0644\u0644\u0645\u062D\u0631\u0651\u0643
        \u064A\u0628\u064A\u0651\u0646 \u062D\u0627\u0644\u0629 \u0627\u0644\u0645\u062D\u0631\u0651\u0643
        \u0628\u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0623\u0648 \u0627\u0644\u0648\u0645\u064A\u0636"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Scale_Def
      value: "\u0627\u0644\u0645\u0633\u0637\u0631\u0629 \u0627\u0644\u0645\u062F\u0631\u0651\u062C\u0629
        \u0645\u0631\u062C\u0639 \u0628\u0635\u0631\u064A \u062B\u0627\u0628\u062A
        \u0644\u0645\u0648\u0636\u0639 \u0627\u0644\u0645\u0632\u0644\u0651\u0650\u0642."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Emergency_Button_Def
      value: "\u0632\u0631 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0632\u0631
        \u0643\u0628\u064A\u0631 \u0645\u064F\u062B\u0628\u062A \u0627\u0644\u0642\u0641\u0644
        \u064A\u0642\u0637\u0639 \u0637\u0627\u0642\u0629 \u0627\u0644\u062D\u0631\u0643\u0629
        \u0641\u0648\u0631\u064B\u0627 \u0644\u0644\u0633\u0644\u0627\u0645\u0629"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Ultrasonic_Sensor_Def
      value: "\u062D\u0633\u0627\u0633 \u0642\u064A\u0627\u0633 \u0645\u0633\u0627\u0641\u0629
        \u0628\u062F\u0648\u0646 \u062A\u0644\u0627\u0645\u0633 \u064A\u0633\u062A\u062E\u062F\u0645
        \u0645\u0648\u062C\u0627\u062A \u0635\u0648\u062A\u064A\u0629 \u0639\u0627\u0644\u064A\u0629
        \u0627\u0644\u062A\u0631\u062F\u062F \u0644\u0642\u064A\u0627\u0633 \u0627\u0644\u0645\u0633\u0627\u0641\u0629
        \u0625\u0644\u0649 \u062C\u0633\u0645 \u0645\u0627 \u0645\u0646 \u062E\u0644\u0627\u0644
        \u0632\u0645\u0646 \u0631\u062C\u0648\u0639 \u0627\u0644\u0635\u062F\u0649."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Power_Screw_Def
      value: "\u0642\u0644\u0627\u0648\u0638 \u0642\u062F\u0631\u0629 \u200F(\u0644\u0648\u0644\u0628
