        \u0627\u0644\u064A\u062F\u0648\u064A\u061F"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01_A
      value: "\u064A\u0646\u062E\u0641\u0636 \u0627\u0644\u0636\u063A\u0637"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01_B
      value: "\u064A\u0631\u062A\u0641\u0639 \u0627\u0644\u0636\u063A\u0637 "
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01_C
      value: "\u064A\u0646\u0637\u0641\u0626 \u0627\u0644\u0646\u0638\u0627\u0645"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_03
      value: "\u064A\u0639\u062A\u0645\u062F \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639
        \u0639\u0644\u0649 \u062A\u062D\u062F\u064A\u062F \u0627\u0644\u0636\u063A\u0637
        \u0627\u0644\u0645\u0646\u0627\u0633\u0628 \u0639\u0644\u0649 \u0637\u0648\u0644
        \u0627\u0644\u0645\u0633\u0637\u0631\u0629 \u0645\u0646 \u062E\u0644\u0627\u0644
        \u062A\u0637\u0628\u064A\u0642 \u0642\u062F\u0631\u0629 \u0636\u062E \u062B\u0627\u0628\u062A\u0629\u060C
        \u062B\u0645 \u062D\u0633\u0627\u0628 \u0627\u0644\u0632\u0645\u0646 \u0627\u0644\u0644\u0627\u0632\u0645
        \u0644\u0648\u0635\u0648\u0644 \u0627\u0644\u062C\u0647\u0627\u0632 \u0625\u0644\u0649
        \u0627\u0644\u0636\u063A\u0637 \u0627\u0644\u0645\u0637\u0644\u0648\u0628.
        \u0628\u0639\u062F \u0630\u0644\u0643\u060C \u064A\u062A\u0645 \u0641\u0635\u0644
        \u0627\u0644\u0645\u0636\u062E\u0629 \u0628\u0639\u062F \u0627\u0646\u0642\u0636\u0627\u0621
        \u0647\u0630\u0627 \u0627\u0644\u0632\u0645\u0646\u060C \u062B\u0645 \u062A\u062A\u0645
        \u0645\u0644\u0627\u062D\u0638\u0629 \u0627\u0644\u0636\u063A\u0637 \u0627\u0644\u0646\u0647\u0627\u0626\u064A
        \u0627\u0644\u0630\u064A \u064A\u0635\u0644 \u0625\u0644\u064A\u0647 \u0627\u0644\u062C\u0647\u0627\u0632."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_04
      value: "\u0627\u0633\u062A\u062E\u062F\u0645 \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639
        \u0639\u0646\u062F\u0645\u0627 \u062A\u0631\u064A\u062F \u062A\u0634\u063A\u064A\u0644
        \u0627\u0644\u062C\u0647\u0627\u0632 \u0628\u0642\u062F\u0631\u0629 \u0627\u0644\u0645\u0636\u062E\u0629
        \u0645\u0628\u0627\u0634\u0631\u0629\u064B\u060C \u0648\u0644\u064A\u0633
        \u0628\u0648\u0627\u0633\u0637\u0629 \u0642\u064A\u0645\u0629 \u0627\u0644\u0636\u063A\u0637
        \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0637\u0631\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
  - table: {fileID: 11400000, guid: e0f35cb5367b0cf43bb2979d18aa3258, type: 2}
    tableContent:
    - key: Emergency_Switch_Title
