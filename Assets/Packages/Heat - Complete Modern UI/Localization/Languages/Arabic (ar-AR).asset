    - key: Notification_01
      value: "\u0631\u0627\u0642\u0628 \u0627\u0633\u062A\u062C\u0627\u0628\u0629
        \u0627\u0644\u0646\u0638\u0627\u0645 \u0639\u0644\u0649 \u0627\u0644\u0631\u0633\u0645
        \u0627\u0644\u0628\u064A\u0627\u0646\u064A. \u0644\u0627\u062D\u0638 \u0632\u0645\u0646
        \u0627\u0644\u0627\u0631\u062A\u0641\u0627\u0639\u060C \u0648\u0627\u0644\u062A\u062E\u0637\u064A\u060C
        \u0648\u0623\u064A \u062E\u0637\u0623 \u062B\u0627\u0628\u062A."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_02
      value: "\u0631\u0627\u0642\u0628 \u0627\u0633\u062A\u062C\u0627\u0628\u0629
        \u0627\u0644\u0646\u0638\u0627\u0645 \u0639\u0644\u0649 \u0627\u0644\u0631\u0633\u0645
        \u0627\u0644\u0628\u064A\u0627\u0646\u064A. \u0644\u0627\u062D\u0638 \u0632\u0645\u0646
        \u0627\u0644\u0627\u0631\u062A\u0641\u0627\u0639\u060C \u0648\u0627\u0644\u062A\u062E\u0637\u064A\u060C
        \u0648\u0623\u064A \u062E\u0637\u0623 \u062B\u0627\u0628\u062A"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: You_are_done
      value: "\u0644\u0642\u062F \u0627\u0646\u062A\u0647\u064A\u062A \u0645\u0646
        \u062A\u062C\u0631\u0628\u0629 1: PID! \u064A\u0645\u0643\u0646\u0643 \u0627\u0644\u0622\u0646
        \u062A\u062D\u0644\u064A\u0644 \u0646\u062A\u0627\u0626\u062C\u0643 \u0623\u0648
        \u0627\u062E\u062A\u064A\u0627\u0631 \u062A\u062C\u0631\u0628\u0629 \u0623\u062E\u0631\u0649."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01_D
      value: "\u0643\u0644 \u0645\u0627 \u0633\u0628\u0642"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_03
      value: "\u064A\u0639\u062A\u0645\u062F \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639
        \u0639\u0644\u0649 \u062A\u062D\u062F\u064A\u062F \u0645\u0648\u0636\u0639
        \u0627\u0644\u0645\u062D\u0631\u0643 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0637\u0631\u0629\u060C
        \u0648\u0630\u0644\u0643 \u0645\u0646 \u062E\u0644\u0627\u0644 \u062A\u062B\u0628\u064A\u062A
        \u0642\u064A\u0645\u0629 \u0627\u0644\u062C\u0647\u062F \u062B\u0645 \u062D\u0633\u0627\u0628
        \u0627\u0644\u0632\u0645\u0646 \u0627\u0644\u0644\u0627\u0632\u0645 \u0644\u0648\u0635\u0648\u0644
        \u0627\u0644\u0645\u062D\u0631\u0643 \u0625\u0644\u0649 \u0627\u0644\u0646\u0642\u0637\u0629
        \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629. \u0628\u0639\u062F \u0630\u0644\u0643
        \u064A\u062A\u0645 \u0641\u0635\u0644 \u0627\u0644\u062C\u0647\u062F \u0639\u0646\u062F
        \u0627\u0646\u062A\u0647\u0627\u0621 \u0647\u0630\u0627 \u0627\u0644\u0632\u0645\u0646\u060C
        \u062B\u0645 \u0645\u0644\u0627\u062D\u0638\u0629 \u0627\u0644\u0645\u0648\u0636\u0639
        \u0627\u0644\u0646\u0647\u0627\u0626\u064A \u0627\u0644\u0630\u064A \u0648\u0635\u0644
        \u0625\u0644\u064A\u0647 \u0627\u0644\u0645\u062D\u0631\u0643."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: 'Notification_04

'
      value: "\u0642\u0645 \u0628\u0627\u062E\u062A\u064A\u0627\u0631 \u0647\u0630\u0627
        \u0627\u0644\u0648\u0636\u0639 \u0639\u0646\u062F\u0645\u0627 \u062A\u0631\u064A\u062F
        \u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u0645\u062D\u0631\u0643 \u0628\u062A\u062D\u062F\u064A\u062F
        \u0641\u0631\u0642 \u0627\u0644\u062C\u0647\u062F \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u060C
        \u0648\u0644\u064A\u0633 \u0645\u0646 \u062E\u0644\u0627\u0644 \u062A\u062D\u062F\u064A\u062F
        \u0645\u0648\u0636\u0639 \u0627\u0644\u0645\u0633\u0637\u0631\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
  - table: {fileID: 11400000, guid: 6be66fa07a46b1c4c8128c7abcecfd3f, type: 2}
    tableContent:
    - key: Title
      value: "\u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A \u0645\u0648\u0636\u0639
        \u0645\u062D\u0631\u0643 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u064A\u062F\u0648\u064A"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Title_Header
      value: "\u062A\u062C\u0631\u0628\u0629 2"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Instructor
      value: "\u0645\u0631\u062D\u0628\u064B\u0627! \u0641\u064A \u0647\u0630\u0627
        \u0627\u0644\u0648\u0636\u0639\u060C \u0633\u062A\u062A\u062D\u0643\u0645
        \u064A\u062F\u0648\u064A\u064B\u0651\u0627 \u0641\u064A \u0645\u0648\u0636\u0639
        \u0645\u062D\u0631\u0643 \u0627\u0644\u062A\u064A\u0627\u0631 \u0627\u0644\u0645\u0633\u062A\u0645\u0631
        \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0645\u062F\u062E\u0644\u0627\u062A
        \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062C \u0636\u0645\u0646 \u062A\u0634\u0643\u064A\u0644
        \u062D\u0644\u0642\u0629 \u0645\u0641\u062A\u0648\u062D\u0629 \u0628\u0645\u0639\u0646\u0649
        \u0623\u0646\u0647 \u0644\u0627 \u064A\u0648\u062C\u062F \u062A\u063A\u0630\u064A\u0629
        \u0631\u0627\u062C\u0639\u0629 \u0623\u0648 \u062A\u0635\u062D\u064A\u062D
        \u0622\u0644\u064A. \u0633\u062A\u064F\u0631\u0633\u0644 \u0623\u0648\u0627\u0645\u0631
        \u0645\u0628\u0627\u0634\u0631\u0629 \u0625\u0644\u0649 \u0627\u0644\u0645\u062D\u0631\u0643
        \u0648\u062A\u0634\u0627\u0647\u062F \u0643\u064A\u0641 \u064A\u0633\u062A\u062C\u064A\u0628\u060C
        \u0645\u0645\u0627 \u064A\u0633\u0627\u0639\u062F\u0643 \u0639\u0644\u0649
        \u0641\u0647\u0645 \u0633\u0644\u0648\u0643 \u0648\u0642\u064A\u0648\u062F
        \u0627\u0644\u062A\u062D\u0643\u0645 \u0628\u0627\u0644\u062D\u0644\u0642\u0629
        \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Objectives
      value: "\u0625\u0631\u0633\u0627\u0644 \u0623\u0648\u0627\u0645\u0631 \u064A\u062F\u0648\u064A\u0629
        \u0644\u0645\u0648\u0636\u0639 \u0645\u062D\u0631\u0643 \u0627\u0644\u062A\u064A\u0627\u0631
        \u0627\u0644\u0645\u0633\u062A\u0645\u0631 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u0627\u0644\u062A\u062D\u0643\u0645 \u0628\u0627\u0644\u062D\u0644\u0642\u0629
        \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629\u060C \u0648\u0645\u0631\u0627\u0642\u0628\u0629
        \u0627\u0644\u062D\u0631\u0643\u0629 \u0627\u0644\u0632\u0627\u0648\u064A\u0629
        \u0627\u0644\u0646\u0627\u062A\u062C\u0629 \u0641\u064A \u0627\u0644\u0632\u0645\u0646
        \u0627\u0644\u062D\u0642\u064A\u0642\u064A\u060C \u0648\u062A\u062D\u0644\u064A\u0644
        \u0643\u064A\u0641 \u064A\u0624\u062B\u0631 \u063A\u064A\u0627\u0628 \u0627\u0644\u062A\u063A\u0630\u064A\u0629
        \u0627\u0644\u0631\u0627\u062C\u0639\u0629 \u0639\u0644\u0649 \u062F\u0642\u0629
        \u0627\u0644\u0645\u0648\u0636\u0639\u060C \u0625\u0645\u0643\u0627\u0646\u064A\u0629
        \u0627\u0644\u062A\u0643\u0631\u0627\u0631\u060C \u0648\u0627\u0633\u062A\u062C\u0627\u0628\u0629
        \u0627\u0644\u0646\u0638\u0627\u0645."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pull_Emergency
      value: "\u0642\u0645 \u0628\u0625\u0637\u0644\u0627\u0642 \u0645\u0641\u062A\u0627\u062D
        \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0645\u0648\u062C\u0648\u062F
        \u0639\u0644\u0649 \u0627\u0644\u0646\u0645\u0648\u0630\u062C \u0627\u0644\u062A\u062C\u0631\u064A\u0628\u064A."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
