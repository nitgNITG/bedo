  - table: {fileID: 11400000, guid: ee757b2896ed3c040ba908d9126b8459, type: 2}
    tableContent:
    - key: Title
      value: "\u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A \u062F\u0631\u062C\u0629
        \u0627\u0644\u062D\u0631\u0627\u0631\u0629 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u0648\u062D\u062F\u0629 \u0627\u0644\u062A\u062D\u0643\u0645 PID\r\n(\u0627\u0644\u0648\u0636\u0639
        \u0627\u0644\u062A\u0644\u0642\u0627\u0626\u064A)\r\n"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Title_Header
      value: "\u062A\u062C\u0631\u0628\u0629 1"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Instructor
      value: "\u0645\u0631\u062D\u0628\u0627\u064B! \u0641\u064A \u0647\u0630\u0647
        \u0627\u0644\u062A\u062C\u0631\u0628\u0629\u060C \u0633\u062A\u0633\u062A\u0643\u0634\u0641
        \u0643\u064A\u0641 \u064A\u0636\u0628\u0637 \u0648\u062D\u062F\u0629 \u0627\u0644\u062A\u062D\u0643\u0645
        PID \u0641\u064A \u0627\u0644\u062D\u0644\u0642\u0629 \u0627\u0644\u0645\u063A\u0644\u0642\u0629
        \u0637\u0627\u0642\u0629 \u0628\u0644\u062A\u064A\u064A\u0631 \u062A\u0644\u0642\u0627\u0626\u064A\u0627\u064B
        \u0644\u0644\u062D\u0641\u0627\u0638 \u0639\u0644\u0649 \u062F\u0631\u062C\u0629
        \u0627\u0644\u062D\u0631\u0627\u0631\u0629 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629\u060C
        \u062D\u062A\u0649 \u0639\u0646\u062F \u0625\u062F\u062E\u0627\u0644 \u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062A
        \u0645\u062B\u0644 \u0627\u0644\u062A\u0628\u0631\u064A\u062F \u0627\u0644\u0646\u0627\u062A\u062C
        \u0639\u0646 \u0627\u0644\u0645\u0631\u0648\u062D\u0629. \u0633\u062A\u0631\u0627\u0642\u0628
        \u0627\u0644\u0627\u0633\u062A\u0642\u0631\u0627\u0631\u060C \u0648\u062A\u0635\u062D\u064A\u062D
        \u0627\u0644\u062E\u0637\u0623\u060C \u0648\u0627\u0644\u0627\u0633\u062A\u062C\u0627\u0628\u0629
        \u0627\u0644\u062F\u064A\u0646\u0627\u0645\u064A\u0643\u064A\u0629 \u0641\u064A
        \u0627\u0644\u0648\u0642\u062A \u0627\u0644\u062D\u0642\u064A\u0642\u064A."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Objectives
      value: "\u062A\u0647\u062F\u0641 \u0647\u0630\u0647 \u0627\u0644\u062A\u062C\u0631\u0628\u0629
        \u0625\u0644\u0649 \u062F\u0631\u0627\u0633\u0629 \u0623\u062F\u0627\u0621
        \u0646\u0638\u0627\u0645 \u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A
        \u062F\u0631\u062C\u0629 \u0627\u0644\u062D\u0631\u0627\u0631\u0629 \u0641\u064A
        \u0627\u0644\u062D\u0644\u0642\u0629 \u0627\u0644\u0645\u063A\u0644\u0642\u0629
        \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0648\u062D\u062F\u0629
        \u062A\u062D\u0643\u0645. PID  "
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pull_Emergency
      value: "\u0642\u0645 \u0628\u062A\u062D\u0631\u064A\u0631 \u0645\u0641\u062A\u0627\u062D
        \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0645\u0648\u062C\u0648\u062F
