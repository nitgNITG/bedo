      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01
      value: "\u0645\u0627 \u0647\u064A \u0627\u0644\u0633\u0645\u0629 \u0627\u0644\u0631\u0626\u064A\u0633\u064A\u0629
        \u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u062A\u062D\u0643\u0645 \u0628\u0627\u0644\u062D\u0644\u0642\u0629
        \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629 \u0645\u062B\u0644 \u0627\u0644\u0646\u0638\u0627\u0645
