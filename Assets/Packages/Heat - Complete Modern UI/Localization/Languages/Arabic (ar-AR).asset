    - key: Notification_03
      value: "\u0644\u0627\u062D\u0638 \u0623\u0646 LED \u0627\u0644\u062A\u0628\u0631\u064A\u062F
        \u064A\u0636\u064A\u0621 \u0628\u062F\u0644\u0627 \u0645\u0646 \u0627\u0644\u062A\u0633\u062E\u064A\u0646\u060C
        \u0645\u0645\u0627 \u064A\u062F\u0644 \u0639\u0644\u0649 \u0623\u0646 \u062C\u0647\u062F
        \u0648\u062D\u062F\u0629 \u0628\u064A\u0644\u062A\u064A\u064A\u0631 \u0645\u0639\u0643\u0648\u0633."
