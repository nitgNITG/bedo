        \u0648\u0627\u0644\u062E\u0637\u0623 \u0627\u0644\u062B\u0627\u0628\u062A."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_A
      value: "\u0632\u064A\u0627\u062F\u0629 \u0627\u0644\u062E\u0637\u0623 \u0627\u0644\u062B\u0627\u0628\u062A"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_B
      value: "\u062A\u0642\u0644\u064A\u0644 \u0627\u0644\u062A\u062E\u0637\u064A
        \u0648\u062A\u062D\u0633\u064A\u0646 \u0627\u0644\u0627\u0633\u062A\u0642\u0631\u0627\u0631 "
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_C
      value: "\u0625\u0632\u0627\u0644\u0629 \u0643\u0644 \u0627\u0644\u0636\u0648\u0636\u0627\u0621"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_02
      value: "\u0642\u0627\u0631\u0646 \u0627\u0644\u0627\u0633\u062A\u062C\u0627\u0628\u0627\u062A:
        \u0647\u0644 \u0623\u0632\u0627\u0644 Ki \u0627\u0644\u062E\u0637\u0623 \u0627\u0644\u062B\u0627\u0628\u062A\u061F
        \u0647\u0644 \u0642\u0644\u0644 Kd \u0645\u0646 \u0627\u0644\u062A\u062E\u0637\u064A\u061F"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Export_Button
      value: "\u0642\u0645 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
        \"Export\" \u0644\u062D\u0641\u0638 \u0627\u0644\u0628\u064A\u0627\u0646\u0627\u062A
        \u0628\u0645\u0644\u0641 \u0627\u0643\u0633\u064A\u0644."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pause_Button
      value: "\u0642\u0645 \u0628\u0625\u064A\u0642\u0627\u0641 \u062A\u0634\u063A\u064A\u0644
        \u0627\u0644\u0639\u0645\u0644\u064A\u0629 \u0639\u0646 \u0637\u0631\u064A\u0642
        \u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649 \"Pause\""
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Alarm_Critical_Level_Reached
      value: "\u062A\u062D\u0630\u064A\u0631: \u062E\u0632\u0627\u0646 \u0627\u0644\u0645\u064A\u0627\u0647
        \u0645\u0645\u062A\u0644\u0626 \u0628\u0646\u0633\u0628\u0629 90%. \u0627\u0644\u0645\u062D\u0627\u0643\u0627\u0629
        \u0645\u062A\u0648\u0642\u0641\u0629 \u0645\u0624\u0642\u062A\u064B\u0627
        \u062D\u062A\u0649 \u064A\u0635\u0644 \u0627\u0644\u0646\u0638\u0627\u0645
        \u0625\u0644\u0649 \u0645\u0633\u062A\u0648\u0649 \u0645\u064A\u0627\u0647
        \u0622\u0645\u0646."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_03
      value: "\u064A\u0639\u062A\u0645\u062F \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639
        \u0639\u0644\u0649 \u062A\u062D\u062F\u064A\u062F \u0627\u0644\u0645\u0633\u062A\u0648\u0649
        \u0639\u0644\u0649 \u0637\u0648\u0644 \u0627\u0644\u062A\u062F\u0631\u064A\u062C
        \u0645\u0646 \u062E\u0644\u0627\u0644 \u062A\u0637\u0628\u064A\u0642 \u0642\u062F\u0631\u0629
        \u0636\u062E \u062B\u0627\u0628\u062A\u0629\u060C \u062B\u0645 \u062D\u0633\u0627\u0628
        \u0627\u0644\u0648\u0642\u062A \u0627\u0644\u0644\u0627\u0632\u0645 \u0644\u0648\u0635\u0648\u0644
        \u0627\u0644\u062C\u0647\u0627\u0632 \u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u062A\u0648\u0649
        \u0627\u0644\u0645\u0637\u0644\u0648\u0628.\r\n\u0628\u0639\u062F \u0630\u0644\u0643\u060C
        \u064A\u062A\u0645 \u0641\u0635\u0644 \u0642\u062F\u0631\u0629 \u0627\u0644\u0645\u0636\u062E\u0629
        \u0628\u0639\u062F \u0627\u0646\u0642\u0636\u0627\u0621 \u0647\u0630\u0627
        \u0627\u0644\u0648\u0642\u062A\u060C \u062B\u0645 \u062A\u062A\u0645 \u0645\u0644\u0627\u062D\u0638\u0629
        \u0627\u0644\u0645\u0633\u062A\u0648\u0649 \u0627\u0644\u0646\u0647\u0627\u0626\u064A
        \u0627\u0644\u0630\u064A \u064A\u0635\u0644 \u0625\u0644\u064A\u0647 \u0627\u0644\u062C\u0647\u0627\u0632."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_04
      value: "\u0627\u0633\u062A\u062E\u062F\u0645 \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639
        \u0639\u0646\u062F\u0645\u0627 \u062A\u0631\u064A\u062F \u062A\u0634\u063A\u064A\u0644
        \u0627\u0644\u062C\u0647\u0627\u0632 \u0628\u0642\u062F\u0631\u0629 \u0627\u0644\u0645\u0636\u062E\u0629
        \u0645\u0628\u0627\u0634\u0631\u0629\u064B\u060C \u0648\u0644\u064A\u0633
        \u0628\u0648\u0627\u0633\u0637\u0629 \u0642\u064A\u0645\u0629 \u0645\u0639\u062F\u0644
        \u0627\u0644\u062A\u062F\u0641\u0642 \u0639\u0644\u0649 \u0627\u0644\u062A\u062F\u0631\u064A\u062C."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
