      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_02
      value: "\u0644\u0627\u062D\u0638 \u062A\u0623\u062B\u064A\u0631 \u0627\u0644\u0645\u0648\u0644\u062F
