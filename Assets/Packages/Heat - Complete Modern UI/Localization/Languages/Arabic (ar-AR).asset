  - table: {fileID: 11400000, guid: 0c530181cd118714f82b4f24ccfb0704, type: 2}
    tableContent:
    - key: DC_Motor_Title
      value: "\u0645\u062D\u0631\u0643 \u062A\u064A\u0627\u0631 \u0645\u0633\u062A\u0645\u0631"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: DC_Motor_Def
      value: "\u0645\u062D\u0631\u0643 \u062A\u064A\u0627\u0631 \u0645\u0633\u062A\u0645\u0631
        \u064A\u062D\u0648\u0651\u0644 \u0627\u0644\u0642\u062F\u0631\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064A\u0629
        \u0627\u0644\u0645\u0633\u062A\u0645\u0631\u0629 \u0625\u0644\u0649 \u062D\u0631\u0643\u0629
        \u062F\u0648\u0631\u0627\u0646\u064A\u0629 \u0639\u0628\u0631 \u0627\u0644\u0645\u062C\u0627\u0644\u0627\u062A
        \u0627\u0644\u0645\u063A\u0646\u0627\u0637\u064A\u0633\u064A\u0629 \u0648\u0627\u0644\u062A\u0628\u062F\u064A\u0644."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Inductive_Proximity_Sensor_Title
      value: "\u062D\u0633\u0627\u0633 \u0642\u0631\u0628 \u062D\u062B\u0651\u064A"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Inductive_Proximity_Sensor_Def
      value: "\u062D\u0633\u0627\u0633 \u0642\u0631\u0628 \u062D\u062B\u0651\u064A
        \u064A\u0643\u062A\u0634\u0641 \u0627\u0644\u0623\u062C\u0633\u0627\u0645
        \u0627\u0644\u0645\u0639\u062F\u0646\u064A\u0629 \u0628\u062F\u0648\u0646
        \u062A\u0644\u0627\u0645\u0633 \u0639\u0628\u0631 \u062A\u064A\u0627\u0631\u0627\u062A
        \u062F\u0648\u0627\u0645\u064A\u0629 \u0648\u062A\u063A\u064A\u0651\u0631
        \u0627\u0644\u0645\u062C\u0627\u0644."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Generator_Title
      value: "\u0645\u0648\u0644\u062F"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Generator_Def
      value: "\u0645\u0648\u0644\u062F \u064A\u062D\u0648\u0651\u0644 \u0627\u0644\u0642\u062F\u0631\u0629
        \u0627\u0644\u0645\u064A\u0643\u0627\u0646\u064A\u0643\u064A\u0629 \u0645\u0646
        \u0627\u0644\u0639\u0645\u0648\u062F \u0625\u0644\u0649 \u062E\u0631\u062C
        \u0643\u0647\u0631\u0628\u0627\u0626\u064A. \u0641\u064A \u0647\u0630\u0627
        \u0627\u0644\u0645\u0639\u0645\u0644 \u064A\u0639\u0645\u0644 \u0643\u062D\u0645\u0644
        \u0648\u0645\u0635\u062F\u0631 \u0625\u0634\u0627\u0631\u0629 \u0633\u0631\u0639\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Speed_Digital_Display_Title
      value: "\u0634\u0627\u0634\u0629 \u0631\u0642\u0645\u064A\u0629 \u0644\u0644\u0633\u0631\u0639\u0629"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Speed_Digital_Display_Def
      value: "\u0634\u0627\u0634\u0629 \u0631\u0642\u0645\u064A\u0629 \u0644\u0644\u0633\u0631\u0639\u0629
        \u0639\u062F\u0651\u0627\u062F \u0644\u0648\u062D\u064A \u064A\u0639\u0631\u0636
        \u0633\u0631\u0639\u0629 \u0627\u0644\u0645\u062D\u0631\u0643 \u0645\u0646
        \u062D\u0633\u0627\u0633 \u0623\u0648 \u062A\u0627\u0643\u0648."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Emergency_Switch_Title
      value: "\u0632\u0631 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 "
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Emergency_Switch_Def
      value: "\u0632\u0631 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0632\u0631
        \u0641\u0637\u0631\u064A \u0645\u0642\u0641\u0651\u0644 \u064A\u0642\u0637\u0639
        \u0637\u0627\u0642\u0629 \u0627\u0644\u062D\u0631\u0643\u0629 \u0644\u0644\u0633\u0644\u0627\u0645\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ON_OFF_Button_Title
      value: "\u0632\u0631 \u0627\u0644\u062A\u0634\u063A\u064A\u0644/\u0627\u0644\u0625\u064A\u0642\u0627\u0641"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ON_OFF_Button_Def
      value: "\u0632\u0631 \u0627\u0644\u062A\u0634\u063A\u064A\u0644/\u0627\u0644\u0625\u064A\u0642\u0627\u0641
