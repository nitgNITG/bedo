        \u0646\u0642\u0637\u0629 \u0627\u0644\u062A\u062D\u062F\u064A\u062F \u0648\u062A\u0642\u0644\u064A\u0644
        \u0627\u0644\u062E\u0637\u0623."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_01
      value: "\u0631\u0627\u0642\u0628 \u0627\u0633\u062A\u062C\u0627\u0628\u0629
