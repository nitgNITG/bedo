  - table: {fileID: 11400000, guid: 3c00e5ce877b9364392e9e06cad4d092, type: 2}
    tableContent:
    - key: Tank_Title
      value: "\u062E\u0632\u0627\u0646"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Tank_Def
      value: "\u064A\u062E\u0632\u0646 \u0627\u0644\u0633\u0627\u0626\u0644 \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645
        \u0641\u064A \u0627\u0644\u0639\u0645\u0644\u064A\u0629 \u0648\u064A\u0633\u0645\u062D
        \u0628\u062A\u062F\u0641\u0642 \u0627\u0644\u0645\u0627\u0621 \u0628\u0634\u0643\u0644
        \u0645\u0633\u062A\u0645\u0631 \u062F\u0627\u062E\u0644 \u0646\u0638\u0627\u0645
        \u0627\u0644\u062D\u0644\u0642\u0629 \u0627\u0644\u0645\u063A\u0644\u0642\u0629\u060C
        \u0648\u064A\u0633\u0627\u0639\u062F \u0639\u0644\u0649 \u062A\u0635\u0648\u0631
        \u0639\u0645\u0644\u064A\u0629 \u0627\u0644\u062A\u062F\u0641\u0642"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Rotameter_Title
      value: "\u0627\u0644\u0631\u0648\u062A\u0627\u0645\u064A\u062A\u0631"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Rotameter_Def
      value: "\u0645\u0642\u064A\u0627\u0633 \u062A\u062F\u0641\u0642 \u0628\u0645\u0633\u0627\u062D\u0629
        \u0645\u062A\u063A\u064A\u0631\u0629 \u064A\u0631\u062A\u0641\u0639 \u0641\u064A\u0647
        \u0627\u0644\u0639\u0648\u0627\u0645\u0629 \u0645\u0639 \u0627\u0644\u062A\u062F\u0641\u0642
        \u0644\u062A\u0634\u064A\u0631 \u0625\u0644\u0649 \u0627\u0644\u0645\u0639\u062F\u0644
        \u0639\u0644\u0649 \u0645\u0633\u0637\u0631\u0629"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pump_Title
      value: "\u0627\u0644\u0645\u0636\u062E\u0629"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pump_Def
      value: "\u062A\u0639\u0645\u0644 \u0627\u0644\u0645\u0636\u062E\u0629 \u0643\u0639\u0646\u0635\u0631
        \u0645\u062D\u0631\u0643 \u0644\u0644\u0646\u0638\u0627\u0645. \u062A\u0642\u0648\u0645
        \u0628\u062F\u0641\u0639 \u0627\u0644\u0645\u0627\u0621 \u0639\u0628\u0631
        \u0634\u0628\u0643\u0629 \u0627\u0644\u0623\u0646\u0627\u0628\u064A\u0628
        \u0639\u0646 \u0637\u0631\u064A\u0642 \u062A\u062D\u0648\u064A\u0644 \u0627\u0644\u0637\u0627\u0642\u0629
        \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064A\u0629 \u0625\u0644\u0649
        \u0637\u0627\u0642\u0629 \u0647\u064A\u062F\u0631\u0648\u0644\u064A\u0643\u064A\u0629.
        \u064A\u062A\u0645 \u0636\u0628\u0637 \u0642\u062F\u0631\u0629 \u0627\u0644\u0645\u0636\u062E\u0629
        \u0628\u0648\u0627\u0633\u0637\u0629 \u0648\u062D\u062F\u0629 \u0627\u0644\u062A\u062D\u0643\u0645
        \u0623\u0648 \u064A\u062F\u0648\u064A\u064B\u0627 \u0645\u0646 \u0642\u0628\u0644
        \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645 \u0644\u062A\u0646\u0638\u064A\u0645
        \u0645\u0639\u062F\u0644 \u0627\u0644\u062A\u062F\u0641\u0642"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Flowmeter_Sensor_Title
      value: "\u062D\u0633\u0627\u0633 \u0645\u0642\u064A\u0627\u0633 \u0627\u0644\u062A\u062F\u0641\u0642"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Flowmeter_Sensor_Def
      value: "\u064A\u0642\u0648\u0645 \u062D\u0633\u0627\u0633 \u0645\u0642\u064A\u0627\u0633
        \u0627\u0644\u062A\u062F\u0641\u0642 \u0628\u0642\u064A\u0627\u0633 \u0645\u0639\u062F\u0644
        \u0627\u0644\u062A\u062F\u0641\u0642 \u0627\u0644\u0641\u0639\u0644\u064A
        \u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A\u064B\u0627 \u0648\u0625\u0631\u0633\u0627\u0644
        \u0647\u0630\u0647 \u0627\u0644\u0625\u0634\u0627\u0631\u0629 \u0625\u0644\u0649
        \u0648\u062D\u062F\u0629 \u0627\u0644\u062A\u062D\u0643\u0645. \u0648\u064A\u0639\u0645\u0644
        \u0643\u0639\u0646\u0635\u0631 \u062A\u063A\u0630\u064A\u0629 \u0631\u0627\u062C\u0639\u0629
        \u0641\u064A \u0627\u0644\u062A\u062D\u0643\u0645 \u0630\u0648 \u0627\u0644\u062D\u0644\u0642\u0629
        \u0627\u0644\u0645\u063A\u0644\u0642\u0629\u060C \u0645\u0645\u0627 \u064A\u062A\u064A\u062D
        \u0645\u0642\u0627\u0631\u0646\u0629 \u062F\u0642\u064A\u0642\u0629 \u0628\u064A\u0646
        \u0627\u0644\u062A\u062F\u0641\u0642 \u0627\u0644\u0645\u0642\u0627\u0633
        \u0648\u0627\u0644\u0646\u0642\u0637\u0629 \u0627\u0644\u0645\u0636\u0628\u0648\u0637\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Proportional_Valve_Title
      value: "\u0635\u0645\u0627\u0645 \u062A\u0646\u0627\u0633\u0628\u064A"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Proportional_Valve_Def
      value: "\u064A\u064F\u063A\u064A\u0651\u0631 \u0627\u0644\u0641\u062A\u062D\u0629
        \u0643\u0647\u0631\u0628\u0627\u0626\u064A\u064B\u0627 \u0644\u0644\u062A\u062D\u0643\u0645
        \u0628\u0627\u0644\u062A\u062F\u0641\u0642 \u0648\u064A\u064F\u0633\u062A\u062E\u062F\u0645
        \u0644\u0644\u062A\u062D\u0643\u0645 \u0641\u064A \u0645\u0642\u0627\u0648\u0645\u0629
        \u0627\u0644\u062A\u062F\u0641\u0642 \u062F\u0627\u062E\u0644 \u0627\u0644\u0646\u0638\u0627\u0645
        \u0648\u064A\u0639\u0645\u0644 \u0643\u0639\u0646\u0635\u0631 \u0625\u0632\u0639\u0627\u062C\u060C
        \u0645\u0645\u0627 \u064A\u0633\u0645\u062D \u0628\u062A\u0642\u064A\u064A\u062F
        \u0627\u0644\u062A\u062F\u0641\u0642 \u0628\u0634\u0643\u0644 \u0645\u0636\u0628\u0648\u0637
        \u0644\u062F\u0631\u0627\u0633\u0629 \u0627\u0633\u062A\u062C\u0627\u0628\u0629
        \u0627\u0644\u0646\u0638\u0627\u0645 \u0648\u0623\u062F\u0627\u0621 \u0648\u062D\u062F\u0629
        \u0627\u0644\u062A\u062D\u0643\u0645 \u0648\u0642\u062F\u0631\u062A\u0647\u0627
        \u0639\u0644\u0649 \u0631\u0641\u0636 \u0627\u0644\u0625\u0632\u0639\u0627\u062C"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Schematic_Diagram_Title
      value: "\u0627\u0644\u0645\u062E\u0637\u0637 \u0627\u0644\u062A\u062E\u0637\u064A\u0637\u064A"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Schematic_Diagram_Def
      value: "\u064A\u0639\u0631\u0636 \u0627\u0644\u0645\u062E\u0637\u0637 \u0627\u0644\u062A\u062E\u0637\u064A\u0637\u064A
        \u0627\u0644\u0645\u0648\u062C\u0648\u062F \u0639\u0644\u0649 \u0627\u0644\u0644\u0648\u062D\u0629
        \u0627\u0644\u0623\u0645\u0627\u0645\u064A\u0629 \u062A\u062F\u0641\u0642
        \u0627\u0644\u0639\u0645\u0644\u064A\u0629 \u0648\u062D\u0644\u0642\u0629
        \u0627\u0644\u062A\u062D\u0643\u0645. \u064A\u0633\u0627\u0639\u062F \u0647\u0630\u0627
        \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645\u064A\u0646 \u0639\u0644\u0649
        \u0641\u0647\u0645 \u062A\u062E\u0637\u064A\u0637 \u0627\u0644\u0646\u0638\u0627\u0645\u060C
        \u0648\u0645\u0633\u0627\u0631 \u0627\u0644\u0625\u0634\u0627\u0631\u0627\u062A\u060C
        \u0648\u0627\u0644\u062A\u0641\u0627\u0639\u0644 \u0628\u064A\u0646 \u0648\u062D\u062F\u0629
        \u0627\u0644\u062A\u062D\u0643\u0645 \u0648\u0627\u0644\u062D\u0633\u0627\u0633
        \u0648\u0627\u0644\u0645\u062D\u0631\u0643 \u0648\u0639\u0645\u0644\u064A\u0629
        \u0627\u0644\u062A\u062F\u0641\u0642"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pump_Indication_LED_Title
      value: "\u0645\u0624\u0634\u0631 LED \u0644\u0644\u0645\u0636\u062E\u0629"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pump_Indication_LED_Def
      value: "\u064A\u0634\u064A\u0631 \u0647\u0630\u0627 \u0627\u0644\u0645\u0635\u0628\u0627\u062D
        \u0627\u0644\u0636\u0648\u0626\u064A \u0625\u0644\u0649 \u062D\u0627\u0644\u0629
        \u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u0645\u0636\u062E\u0629. \u0639\u0646\u062F
        \u0625\u0636\u0627\u0621\u062A\u0647\u060C \u064A\u0624\u0643\u062F \u0623\u0646
        \u0627\u0644\u0645\u0636\u062E\u0629 \u062A\u0639\u0645\u0644 \u0648\u062A\u0632\u0648\u062F
        \u0627\u0644\u0646\u0638\u0627\u0645 \u0628\u0627\u0644\u062A\u062F\u0641\u0642"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Valve_Indication_LED_Title
      value: "\u0645\u0624\u0634\u0631 LED \u0644\u0644\u0635\u0645\u0627\u0645"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Valve_Indication_LED_Def
      value: "\u064A\u0639\u0631\u0636 \u0647\u0630\u0627 \u0627\u0644\u0645\u0635\u0628\u0627\u062D
        \u0627\u0644\u0636\u0648\u0626\u064A \u062D\u0627\u0644\u0629 \u0627\u0644\u0635\u0645\u0627\u0645
        \u0627\u0644\u0646\u0633\u0628\u064A. \u0648\u064A\u0648\u0641\u0631 \u0645\u0624\u0634\u0631\u064B\u0627
        \u0628\u0635\u0631\u064A\u064B\u0627 \u0633\u0631\u064A\u0639\u064B\u0627
        \u0644\u062A\u0641\u0639\u064A\u0644 \u0627\u0644\u0635\u0645\u0627\u0645
        \u0623\u062B\u0646\u0627\u0621 \u062A\u062C\u0627\u0631\u0628 \u0627\u0644\u0625\u0632\u0639\u0627\u062C."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Emergency_Button_Title
      value: "\u0632\u0631 \u0627\u0644\u0637\u0648\u0627\u0631\u0626"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Emergency_Button_Def
      value: "\u0632\u0631 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0647\u0648
        \u0645\u064A\u0632\u0629 \u0623\u0645\u0627\u0646 \u062A\u0642\u0648\u0645
        \u0628\u0625\u064A\u0642\u0627\u0641 \u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u0646\u0638\u0627\u0645
        \u0641\u0648\u0631\u064B\u0627 \u0641\u064A \u062D\u0627\u0644\u0629 \u0648\u062C\u0648\u062F
        \u0638\u0631\u0648\u0641 \u063A\u064A\u0631 \u0637\u0628\u064A\u0639\u064A\u0629
        \u0623\u0648 \u062E\u0637\u0623 \u0645\u0646 \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645.
        \u0648\u064A\u0636\u0645\u0646 \u0630\u0644\u0643 \u0627\u0644\u062A\u0634\u063A\u064A\u0644
        \u0627\u0644\u0622\u0645\u0646 \u0644\u0644\u062C\u0647\u0627\u0632 \u0627\u0644\u062A\u062F\u0631\u064A\u0628\u064A"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ON_OFF_Trainer_Switch_Title
      value: "\u0645\u0641\u062A\u0627\u062D \u062A\u0634\u063A\u064A\u0644/\u0625\u064A\u0642\u0627\u0641
        \u0627\u0644\u0645\u0639\u0645\u0644 "
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ON_OFF_Trainer_Switch_Def
      value: "\u064A\u0645\u0643\u0651\u0646 \u0623\u0648 \u064A\u0639\u0637\u0651\u0644
