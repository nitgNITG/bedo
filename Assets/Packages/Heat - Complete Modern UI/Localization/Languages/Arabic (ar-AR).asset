      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Use_PowerOnly_Mode
      value: "\u0642\u0645 \u0628\u062A\u0641\u0639\u064A\u0644 \u0627\u0644\u0645\u0641\u062A\u0627\u062D
        \u0641\u064A \u0627\u062A\u062C\u0627\u0647 \u0646\u0633\u0628\u0629 \u0627\u0644\u0637\u0627\u0642\u0629."
