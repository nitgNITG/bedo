      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02
      value: "\u0623\u064A \u0645\u0645\u0627 \u064A\u0644\u064A \u064A\u0635\u0641
        \u0623\u0641\u0636\u0644 \u062A\u0645\u062B\u064A\u0644 \u0644\u062F\u0648\u0631
