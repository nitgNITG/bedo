  - table: {fileID: 11400000, guid: 448b21e81e55d3345b80cf749c26107b, type: 2}
    tableContent:
    - key: Title
      value: "\u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A \u0627\u0644\u062A\u062F\u0641\u0642
        \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0648\u062D\u062F\u0629
        \u0627\u0644\u062A\u062D\u0643\u0645 PID"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Title_Header
      value: "\u062A\u062C\u0631\u0628\u06291 "
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Instructor
      value: "\u0645\u0631\u062D\u0628\u0627\u064B! \u0641\u064A \u0647\u0630\u0647
        \u0627\u0644\u062A\u062C\u0631\u0628\u0629\u060C \u0633\u062A\u0633\u062A\u0643\u0634\u0641
        \u0643\u064A\u0641 \u064A\u0636\u0628\u0637 \u0646\u0638\u0627\u0645 \u0627\u0644\u062A\u062D\u0643\u0645
        \u0627\u0644\u062D\u0644\u0642\u064A \u0627\u0644\u0645\u063A\u0644\u0642
        (\u0627\u0644\u0630\u064A \u064A\u062D\u062A\u0648\u064A \u0639\u0644\u0649
        \u062A\u063A\u0630\u064A\u0629 \u0631\u0627\u062C\u0639\u0629) \u0637\u0627\u0642\u0629
        \u0627\u0644\u0645\u0636\u062E\u0629 \u062A\u0644\u0642\u0627\u0626\u064A\u0627\u064B
        \u0644\u0644\u062D\u0641\u0627\u0638 \u0639\u0644\u0649 \u0645\u0639\u062F\u0644
        \u062A\u062F\u0641\u0642 \u0645\u0637\u0644\u0648\u0628. \u064A\u0642\u0627\u0631\u0646
        \u0627\u0644\u0646\u0638\u0627\u0645 \u0628\u0627\u0633\u062A\u0645\u0631\u0627\u0631
        \u0628\u064A\u0646 \u0627\u0644\u062A\u062F\u0641\u0642 \u0627\u0644\u0641\u0639\u0644\u064A
        (\u0645\u0646  \u062D\u0633\u0627\u0633 \u0645\u0642\u064A\u0627\u0633 \u0627\u0644\u062A\u062F\u0641\u0642)
        \u0648\u0646\u0642\u0637\u0629 \u0627\u0644\u062A\u062D\u062F\u064A\u062F\u060C
        \u0648\u064A\u0635\u062D\u062D \u0623\u064A \u062E\u0637\u0623 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u0648\u062D\u062F\u0629 \u062A\u062D\u0643\u0645 PID. \u0633\u064A\u0633\u0627\u0639\u062F\u0643
        \u0630\u0644\u0643 \u0639\u0644\u0649 \u0641\u0647\u0645 \u0627\u0644\u0637\u0628\u064A\u0639\u0629
        \u0627\u0644\u062A\u0644\u0642\u0627\u0626\u064A\u0629 \u0644\u0623\u0646\u0638\u0645\u0629
        \u0627\u0644\u062A\u063A\u0630\u064A\u0629 \u0627\u0644\u0631\u0627\u062C\u0639\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Objectives
      value: "\u062A\u0647\u062F\u0641 \u0647\u0630\u0647 \u0627\u0644\u062A\u062C\u0631\u0628\u0629
        \u0625\u0644\u0649 \u062A\u0648\u0636\u064A\u062D \u0633\u0644\u0648\u0643
        \u0646\u0638\u0627\u0645 \u0627\u0644\u062A\u062D\u0643\u0645 \u0627\u0644\u062D\u0644\u0642\u064A
        \u0627\u0644\u0645\u063A\u0644\u0642 \u0641\u064A \u0639\u0645\u0644\u064A\u0629
        \u0627\u0644\u062A\u062F\u0641\u0642. \u062A\u0647\u064A\u0626\u0629 \u0627\u0644\u0646\u0638\u0627\u0645
        \u0644\u0644\u062A\u062D\u0643\u0645 \u0627\u0644\u062A\u0644\u0642\u0627\u0626\u064A
        \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0648\u062D\u062F\u0629
        \u062A\u062D\u0643\u0645 PID. \u062A\u0639\u064A\u064A\u0646 \u0646\u0642\u0637\u0629
        \u062A\u062D\u062F\u064A\u062F \u0644\u0645\u0639\u062F\u0644 \u0627\u0644\u062A\u062F\u0641\u0642
        \u0648\u0645\u0631\u0627\u0642\u0628\u0629 \u0643\u064A\u0641\u064A\u0629
        \u0627\u0644\u062D\u0641\u0627\u0638 \u0639\u0644\u064A\u0647\u0627 \u0645\u0646
        \u0642\u0628\u0644 \u0648\u062D\u062F\u0629 \u0627\u0644\u062A\u062D\u0643\u0645.
        \u0648\u0625\u062F\u062E\u0627\u0644 \u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062A
        \u0648\u0645\u0631\u0627\u0642\u0628\u0629 \u0643\u064A\u0641\u064A\u0629
        \u062A\u0639\u0648\u064A\u0636 \u0627\u0644\u0646\u0638\u0627\u0645 \u0639\u0646\u0647\u0627. "
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pull_Emergency
      value: "\u062D\u0631\u0631 \u0632\u0631 \u0627\u0644\u0625\u064A\u0642\u0627\u0641
        \u0627\u0644\u0637\u0627\u0631\u0626."
