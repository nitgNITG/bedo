      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01
      value: "\u0645\u0627 \u0647\u064A \u0627\u0644\u0645\u064A\u0632\u0629 \u0627\u0644\u0631\u0626\u064A\u0633\u064A\u0629
