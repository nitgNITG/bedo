      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_C
      value: "\u064A\u0648\u0641\u0631 \u0625\u0632\u0627\u062D\u0629 \u062B\u0627\u0628\u062A\u0629
