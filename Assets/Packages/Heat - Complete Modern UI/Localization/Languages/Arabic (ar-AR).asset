      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Proportional_Solenoid_Valve_Title
      value: "\u0635\u0645\u0627\u0645 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0644\u0648\u0644\u0628\u064A
