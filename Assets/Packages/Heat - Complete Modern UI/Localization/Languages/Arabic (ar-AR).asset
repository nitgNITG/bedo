        \u201CDisturbance%\u201D."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SaveScreen_button
      value: "\u0642\u0645 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
        \"Save Screen\" \u0644\u062D\u0641\u0638 \u0645\u0646\u062D\u0646\u0649 \u0627\u0644\u0627\u0633\u062A\u062C\u0627\u0628\u0629
        \u0627\u0644\u062D\u0627\u0644\u064A"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Export_button
      value: "\u0642\u0645 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
        \"Export\" \u0644\u062D\u0641\u0638 \u0627\u0644\u0628\u064A\u0627\u0646\u0627\u062A
        \u0628\u0645\u0644\u0641 \u0627\u0643\u0633\u064A\u0644."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: You_are_done
      value: "\u0644\u0642\u062F \u0627\u0646\u062A\u0647\u064A\u062A! \u0627\u0644\u0622\u0646
        \u064A\u0645\u0643\u0646\u0643 \u0627\u062E\u062A\u064A\u0627\u0631 \u062A\u062C\u0631\u0628\u0629
        \u0623\u062E\u0631\u0649"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_02
      value: "\u0644\u0627\u062D\u0638 \u0642\u064A\u0645\u0629 \u0645\u0639\u062F\u0644
        \u0627\u0644\u062A\u062F\u0641\u0642 \u0639\u0644\u0649 \u0627\u0644\u0631\u0648\u062A\u0627\u0645\u064A\u062A\u0631"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_01
      value: "\u064A\u0632\u062F\u0627\u062F \u0645\u0639\u062F\u0644 \u0627\u0644\u062A\u062F\u0641\u0642
        \u062A\u0646\u0627\u0633\u0628\u064A\u0627\u064B\u061B \u0648\u0644\u0627
        \u064A\u062D\u062F\u062B \u0623\u064A \u062A\u0646\u0638\u064A\u0645 \u062A\u0644\u0642\u0627\u0626\u064A"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01
      value: "\u062F\u062B \u0625\u0630\u0627 \u0632\u062F\u062A \u0646\u0633\u0628\u0629
        \u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u0645\u0636\u062E\u0629 \u0641\u064A
        \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u064A\u062F\u0648\u064A\u061F"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01_A
      value: "\u064A\u0646\u062E\u0641\u0636 \u0645\u0639\u062F\u0644 \u0627\u0644\u062A\u062F\u0641\u0642"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01_B
      value: "\u064A\u0631\u062A\u0641\u0639 \u0645\u0639\u062F\u0644 \u0627\u0644\u062A\u062F\u0641\u0642"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01_C
      value: "\u0644\u0627 \u064A\u062D\u062F\u062B \u0634\u0626"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02
      value: "\u0644\u0645\u0627\u0630\u0627 \u064A\u064F\u0633\u062A\u062E\u062F\u0645
        \u0635\u0645\u0627\u0645 \u0627\u0644\u0627\u0636\u0637\u0631\u0627\u0628
        \u0641\u064A \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u064A\u062F\u0648\u064A\u061F"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_A
      value: "\u0644\u0644\u062D\u0641\u0627\u0638 \u0639\u0644\u0649 \u0636\u063A\u0637
        \u062B\u0627\u0628\u062A"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_B
      value: "\u0644\u0645\u062D\u0627\u0643\u0627\u0629 \u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062A
        \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0648\u0627\u0642\u0639\u064A\u0629"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_C
      value: "\u0644\u0625\u064A\u0642\u0627\u0641 \u0627\u0644\u0645\u0636\u062E\u0629"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_03
      value: "\u064A\u0639\u062A\u0645\u062F \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639
        \u0639\u0644\u0649 \u062A\u062D\u062F\u064A\u062F \u0645\u0639\u062F\u0644
        \u0627\u0644\u062A\u062F\u0641\u0642 \u0639\u0644\u0649 \u0637\u0648\u0644
        \u0627\u0644\u0645\u0633\u0637\u0631\u0629 \u0645\u0646 \u062E\u0644\u0627\u0644
        \u062A\u0637\u0628\u064A\u0642 \u0642\u062F\u0631\u0629 \u0636\u062E \u062B\u0627\u0628\u062A\u0629\u060C
        \u062B\u0645 \u062D\u0633\u0627\u0628 \u0627\u0644\u0632\u0645\u0646 \u0627\u0644\u0644\u0627\u0632\u0645
        \u0644\u0648\u0635\u0648\u0644 \u0627\u0644\u062C\u0647\u0627\u0632 \u0625\u0644\u0649
        \u0645\u0639\u062F\u0644 \u0627\u0644\u062A\u062F\u0641\u0642 \u0627\u0644\u0645\u0637\u0644\u0648\u0628.
        \u0628\u0639\u062F \u0630\u0644\u0643\u060C \u064A\u062A\u0645 \u0641\u0635\u0644
        \u0642\u062F\u0631\u0629 \u0627\u0644\u0645\u0636\u062E\u0629 \u0628\u0639\u062F
        \u0627\u0646\u0642\u0636\u0627\u0621 \u0647\u0630\u0627 \u0627\u0644\u0632\u0645\u0646\u060C
        \u062B\u0645 \u062A\u062A\u0645 \u0645\u0644\u0627\u062D\u0638\u0629 \u0645\u0639\u062F\u0644
        \u0627\u0644\u062A\u062F\u0641\u0642 \u0627\u0644\u0646\u0647\u0627\u0626\u064A
        \u0627\u0644\u0630\u064A \u064A\u0635\u0644 \u0625\u0644\u064A\u0647 \u0627\u0644\u062C\u0647\u0627\u0632."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_04
      value: "\u0627\u0633\u062A\u062E\u062F\u0645 \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639
        \u0639\u0646\u062F\u0645\u0627 \u062A\u0631\u064A\u062F \u062A\u0634\u063A\u064A\u0644
        \u0627\u0644\u062C\u0647\u0627\u0632 \u0628\u0642\u062F\u0631\u0629 \u0627\u0644\u0645\u0636\u062E\u0629
        \u0645\u0628\u0627\u0634\u0631\u0629\u064B\u060C \u0648\u0644\u064A\u0633
        \u0628\u0648\u0627\u0633\u0637\u0629 \u0642\u064A\u0645\u0629 \u0645\u0639\u062F\u0644
        \u0627\u0644\u062A\u062F\u0641\u0642 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0637\u0631\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
  - table: {fileID: 11400000, guid: c9cbb2a3998113b42833a230ae67d717, type: 2}
    tableContent:
    - key: Title
      value: "\u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A \u0627\u0644\u0636\u063A\u0637
        \u0641\u064A \u062D\u0644\u0642\u0629 \u0645\u0641\u062A\u0648\u062D\u0629\r\n(\u0627\u0644\u0648\u0636\u0639
        \u0627\u0644\u064A\u062F\u0648\u064A)\r"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Title_Header
      value: "\u062A\u062C\u0631\u0628\u0629 2"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Instructor
      value: "\u0645\u0631\u062D\u0628\u064B\u0627! \u0641\u064A \u0647\u0630\u0627
        \u0627\u0644\u0648\u0636\u0639\u060C \u0633\u062A\u062A\u0639\u0644\u0645
        \u0643\u064A\u0641\u064A\u0629 \u0627\u0644\u062A\u062D\u0643\u0645 \u0627\u0644\u064A\u062F\u0648\u064A
        \u0641\u064A \u0627\u0644\u0645\u0636\u062E\u0629 \u0648\u0635\u0645\u0627\u0645
        \u0627\u0644\u0627\u0636\u0637\u0631\u0627\u0628 \u0644\u0645\u0631\u0627\u0642\u0628\u0629
        \u062A\u063A\u064A\u0631\u0627\u062A \u0627\u0644\u0636\u063A\u0637 \u0627\u0644\u0641\u0648\u0631\u064A\u0629
        \u062F\u0648\u0646 \u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0645\u0646\u0638\u0648\u0645
        PID \u0622\u0644\u064A. \u064A\u0633\u0627\u0639\u062F\u0643 \u0630\u0644\u0643
        \u0639\u0644\u0649 \u0641\u0647\u0645 \u0633\u0644\u0648\u0643 \u0627\u0644\u0646\u0638\u0627\u0645
        \u062A\u062D\u062A \u0627\u0644\u062A\u062D\u0643\u0645 \u0627\u0644\u0628\u0634\u0631\u064A
        \u0627\u0644\u0645\u0628\u0627\u0634\u0631."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Objectives
      value: "\u0627\u0644\u062A\u062D\u0643\u0645 \u064A\u062F\u0648\u064A\u064B\u0651\u0627
        \u0641\u064A \u0627\u0644\u0645\u0636\u062E\u0629 \u0648\u0635\u0645\u0627\u0645
        \u0627\u0644\u0627\u0636\u0637\u0631\u0627\u0628 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u0634\u0631\u0627\u0626\u062D \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062C\u060C
        \u0648\u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0633\u062A\u062C\u0627\u0628\u0629
        \u0627\u0644\u0636\u063A\u0637 \u0627\u0644\u0641\u0648\u0631\u064A\u0629\u060C
        \u0648\u0641\u0647\u0645 \u062A\u0623\u062B\u064A\u0631 \u0627\u0644\u0645\u062F\u062E\u0644\u0627\u062A
        \u0627\u0644\u064A\u062F\u0648\u064A\u0629 \u0639\u0644\u0649 \u0627\u0633\u062A\u0642\u0631\u0627\u0631
        \u0627\u0644\u0646\u0638\u0627\u0645 \u0648\u062F\u064A\u0646\u0627\u0645\u064A\u0643\u064A\u0629
        \u0627\u0644\u0636\u063A\u0637"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pull_Emergency
      value: "\u0642\u0645 \u0628\u062A\u062D\u0631\u064A\u0631 \u0645\u0641\u062A\u0627\u062D
        \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0645\u0648\u062C\u0648\u062F
        \u0639\u0644\u0649 \u0627\u0644\u062C\u0647\u0627\u0632."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Switch_On
      value: "\u0642\u0645 \u0628\u062A\u0634\u063A\u064A\u0644 \u0645\u0641\u062A\u0627\u062D
        \u0627\u0644\u062A\u0634\u063A\u064A\u0644/\u0627\u0644\u0625\u064A\u0642\u0627\u0641."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Manual_Mode_Button
      value: "\u0642\u0645 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
        \u0632\u0631 \"Open-Loop Mode\u201D \u0644\u062A\u0639\u0637\u064A\u0644
        PID \u0648\u0627\u0644\u062F\u062E\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u062A\u062D\u0643\u0645
        \u0628\u0627\u0644\u062D\u0644\u0642\u0629 \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Use_PumpAndPressure_Mode
      value: "\u0642\u0645 \u0628\u062A\u0641\u0639\u064A\u0644 \u0627\u0644\u0645\u0641\u062A\u0627\u062D
        \u0641\u064A \u0627\u062A\u062C\u0627\u0647 \u0627\u0644\u0636\u063A\u0637."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SetPressure_01
      value: "\u0642\u0645 \u0628\u0636\u0628\u0637 \u0627\u0644\u0636\u063A\u0637
        \u0639\u0644\u0649 0.5 \u0628\u0627\u0631."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Set_Pump_01
      value: "\u0642\u0645 \u0628\u0636\u0628\u0637 \u0645\u0624\u0634\u0631 \u0627\u0644\u0645\u0636\u062E\u0629
        \u0639\u0644\u0649 30%. "
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Start_Button_01
      value: "\u0642\u0645 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
        \u0632\u0631 \"Start\" \u0644\u0628\u062F\u0621 \u062A\u0634\u063A\u064A\u0644
        \u0627\u0644\u0645\u0636\u062E\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Stop_Button_01
      value: "\u0642\u0645 \u0628\u0625\u0639\u0627\u062F\u0629 \u062A\u0639\u064A\u064A\u0646
        \u0627\u0644\u0639\u0645\u0644\u064A\u0629 \u0627\u0644\u062D\u0627\u0644\u064A\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Use_PumpOnly_Mode
      value: "\u0642\u0645 \u0628\u062A\u0641\u0639\u064A\u0644 \u0627\u0644\u0645\u0641\u062A\u0627\u062D
        \u0641\u064A \u0627\u062A\u062C\u0627\u0647 \u0642\u062F\u0631\u0629 \u062A\u0634\u063A\u064A\u0644
        \u0627\u0644\u0645\u0636\u062E\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Set_Pump_02
      value: "\u0642\u0645 \u0628\u0636\u0628\u0637 \u0645\u0624\u0634\u0631 \u0627\u0644\u0645\u0636\u062E\u0629
        \u0639\u0644\u0649 60%."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Start_Button_02
      value: "\u0642\u0645 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
        Start \u0645\u0631\u0629 \u0623\u062E\u0631\u0649."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Set_Disturbance_01
      value: "\u0642\u0645 \u0628\u0636\u0628\u0637 \u0645\u0624\u0634\u0631 \u0627\u0644\u0627\u0636\u0637\u0631\u0627\u0628
        \u0639\u0644\u0649 90% \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0634\u0631\u064A\u0637
        \u201CDisturbance%\u201D."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SaveScreen_button
      value: "\u0642\u0645 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
        \"Save Screen\" \u0644\u062D\u0641\u0638 \u0645\u0646\u062D\u0646\u0649 \u0627\u0644\u0627\u0633\u062A\u062C\u0627\u0628\u0629
        \u0627\u0644\u062D\u0627\u0644\u064A."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Export_button
      value: "\u0642\u0645 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
        \"Export\" \u0644\u062D\u0641\u0638 \u0627\u0644\u0628\u064A\u0627\u0646\u0627\u062A
        \u0628\u0645\u0644\u0641 \u0627\u0643\u0633\u064A\u0644."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: You_are_done
      value: "\u0644\u0642\u062F \u0627\u0646\u062A\u0647\u064A\u062A! \u064A\u0645\u0643\u0646\u0643
        \u0627\u0644\u0622\u0646 \u062A\u062D\u0644\u064A\u0644 \u0646\u062A\u0627\u0626\u062C\u0643
        \u0623\u0648 \u0627\u062E\u062A\u064A\u0627\u0631 \u062A\u062C\u0631\u0628\u0629
        \u0623\u062E\u0631\u0649."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_01
      value: "\u0644\u0627\u062D\u0638 \u0627\u0631\u062A\u0641\u0627\u0639 \u0627\u0644\u0636\u063A\u0637
        \u0639\u0644\u0649 \u0627\u0644\u0645\u0642\u064A\u0627\u0633."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_02
      value: "\u0644\u0627\u062D\u0638 \u0623\u0646 \u0627\u0644\u0646\u0638\u0627\u0645
        \u0644\u0627 \u064A\u0642\u0648\u0645 \u0628\u062A\u0635\u062D\u064A\u062D
        \u0645\u0648\u0636\u0639\u0647 \u062A\u0644\u0642\u0627\u0626\u064A\u064B\u0627."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02
      value: "\u0644\u0645\u0627\u0630\u0627 \u064A\u064F\u0633\u062A\u062E\u062F\u0645
        \u0635\u0645\u0627\u0645 \u0627\u0644\u0627\u0636\u0637\u0631\u0627\u0628
        \u0641\u064A \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u064A\u062F\u0648\u064A\u061F"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_A
      value: "\u0644\u0644\u062D\u0641\u0627\u0638 \u0639\u0644\u0649 \u0636\u063A\u0637
        \u062B\u0627\u0628\u062A"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_B
      value: "\u0644\u0645\u062D\u0627\u0643\u0627\u0629 \u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062A
        \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0648\u0627\u0642\u0639\u064A\u0629 "
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_C
      value: "\u0644\u0625\u064A\u0642\u0627\u0641 \u0627\u0644\u0645\u0636\u062E\u0629"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01
      value: "\u0645\u0627\u0630\u0627 \u064A\u062D\u062F\u062B \u0625\u0630\u0627
        \u0632\u062F\u062A \u0646\u0633\u0628\u0629 \u062A\u0634\u063A\u064A\u0644
