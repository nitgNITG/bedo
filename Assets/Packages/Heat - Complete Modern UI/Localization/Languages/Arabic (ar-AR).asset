        \u0645\u0627\u0630\u0627 \u064A\u062D\u062F\u062B \u0625\u0630\u0627 \u0648\u0627\u062C\u0647
        \u0627\u0644\u0645\u062D\u0631\u0643 \u062D\u0645\u0644\u0627\u064B \u063A\u064A\u0631
