        \u0639\u0646\u062F \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u064A\u0642\u0648\u0645
        \u0628\u0642\u0637\u0639 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0621
        \u0639\u0646 \u0627\u0644\u062C\u0647\u0627\u0632 \u0641\u0648\u0631\u064B\u0627
        \u0644\u0623\u063A\u0631\u0627\u0636 \u0627\u0644\u0633\u0644\u0627\u0645\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ON_OFF_Button_Title
      value: "\u0632\u0631 \u0627\u0644\u062A\u0634\u063A\u064A\u0644/\u0627\u0644\u0625\u064A\u0642\u0627\u0641"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
