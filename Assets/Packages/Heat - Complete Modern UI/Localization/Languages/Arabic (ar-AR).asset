        (P) \u0641\u064A \u0648\u062D\u062F\u0629 \u062A\u062D\u0643\u0645 PID\u061F"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_01_A
      value: "\u0627\u0644\u0642\u0636\u0627\u0621 \u0639\u0644\u0649 \u0627\u0644\u062E\u0637\u0623
