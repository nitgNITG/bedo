      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Set_Power_01
      value: "\u0642\u0645 \u0628\u0636\u0628\u0637 \u0634\u0631\u064A\u0637 \u062A\u0645\u0631\u064A\u0631
