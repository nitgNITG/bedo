      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Proportional_Solenoid_Valve_Def
      value: "\u064A\u0646\u0638\u0645 \u062A\u062F\u0641\u0642 \u0627\u0644\u0648\u0633\u0637
        \u0641\u064A \u0627\u0644\u0646\u0638\u0627\u0645 \u0639\u0646 \u0637\u0631\u064A\u0642
        \u062A\u0639\u062F\u064A\u0644 \u0645\u0648\u0636\u0639 \u0627\u0644\u0635\u0645\u0627\u0645
        \u0628\u0634\u0643\u0644 \u062A\u0646\u0627\u0633\u0628\u064A \u0645\u0639
        \u0625\u0634\u0627\u0631\u0629 \u0627\u0644\u0625\u062F\u062E\u0627\u0644\u060C
        \u0645\u0645\u0627 \u064A\u0633\u0645\u062D \u0628\u0627\u0644\u062A\u062D\u0643\u0645
        \u0627\u0644\u062F\u0642\u064A\u0642 \u0641\u064A \u0645\u0639\u062F\u0644\u0627\u062A
        \u0627\u0644\u062A\u062F\u0641\u0642 \u0648\u0627\u0644\u0636\u063A\u0637."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Needle_Valve_Title
      value: "\u0635\u0645\u0627\u0645 \u0627\u0644\u0625\u0628\u0631\u0629"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Needle_Valve_Def
      value: "\u064A\u0648\u0641\u0631 \u0636\u0628\u0637\u064B\u0627 \u062F\u0642\u064A\u0642\u064B\u0627
        \u0644\u0644\u062A\u062F\u0641\u0642 \u0648\u0627\u0644\u0636\u063A\u0637
        \u0639\u0646 \u0637\u0631\u064A\u0642 \u0627\u0644\u0633\u0645\u0627\u062D
        \u0628\u0627\u0644\u062A\u062D\u0643\u0645 \u0627\u0644\u062F\u0642\u064A\u0642
        \u0641\u064A \u0645\u0633\u0627\u0631 \u0627\u0644\u0633\u0627\u0626\u0644\u060C
        \u0645\u0645\u0627 \u064A\u062C\u0639\u0644\u0647 \u0645\u062B\u0627\u0644\u064A\u064B\u0627
        \u0644\u0636\u0628\u0637 \u0645\u0633\u062A\u0648\u064A\u0627\u062A \u0627\u0644\u0636\u063A\u0637
        \u0641\u064A \u0627\u0644\u0646\u0638\u0627\u0645."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Valve_Indication_LED_Title
      value: "\u0645\u0624\u0634\u0631 LED \u0644\u0644\u0635\u0645\u0627\u0645 "
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Valve_Indication_LED_Def
