      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Set_Gains_02
      value: "\u0639\u062F\u0651\u0644 Kd \u0625\u0644\u0649 4000 \u0644\u062A\u062D\u0633\u064A\u0646
        \u0627\u0633\u062A\u062C\u0627\u0628\u0629 \u0627\u0644\u0646\u0638\u0627\u0645"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Start_Button_02
