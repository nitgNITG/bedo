        (Kd) \u0641\u064A \u0648\u062D\u062F\u0629 \u062A\u062D\u0643\u0645 PID\u061F"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_A
      value: "\u064A\u0642\u0636\u064A \u0639\u0644\u0649 \u0627\u0644\u062E\u0637\u0623
        \u0627\u0644\u0645\u062A\u0631\u0627\u0643\u0645 \u0645\u0646 \u0627\u0644\u0645\u0627\u0636\u064A."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02_B
