  - table: {fileID: 11400000, guid: 74e04707cfcfcfb43a49b0b47c2a3ec0, type: 2}
    tableContent:
    - key: Title
      value: "\u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A \u0645\u0633\u062A\u0648\u0649
        \u0627\u0644\u0633\u0627\u0626\u0644 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
        \u0648\u062D\u062F\u0629 \u0627\u0644\u062A\u062D\u0643\u0645 PID (\u0627\u0644\u0648\u0636\u0639
        \u0627\u0644\u062A\u0644\u0642\u0627\u0626\u064A) "
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Title_Header
      value: "\u0627\u0644\u062A\u062C\u0631\u0628\u0629 1"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Instructor
      value: "\u0645\u0631\u062D\u0628\u064B\u0627! \u0641\u064A \u0647\u0630\u0647
        \u0627\u0644\u062A\u062C\u0631\u0628\u0629\u060C \u0633\u062A\u062A\u0639\u0644\u0645
        \u0643\u064A\u0641\u064A\u0629 \u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A
        \u0645\u0633\u062A\u0648\u0649 \u0627\u0644\u0633\u0627\u0626\u0644 \u0641\u064A
        \u0627\u0644\u062E\u0632\u0627\u0646 \u0627\u0644\u0639\u0644\u0648\u064A
        \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0648\u062D\u062F\u0629
        \u062A\u062D\u0643\u0645 PID. \u0633\u062A\u0642\u0648\u0645 \u0628\u062F\u0631\u0627\u0633\u0629
        \u062A\u0623\u062B\u064A\u0631 \u0645\u0639\u0627\u0645\u0644\u0627\u062A
        \u0627\u0644\u0643\u0633\u0628 \u0627\u0644\u062A\u0646\u0627\u0633\u0628\u064A
        (Kp)\u060C \u0648\u0627\u0644\u062A\u0643\u0627\u0645\u0644\u064A (Ki)\u060C
        \u0648\u0627\u0644\u062A\u0641\u0627\u0636\u0644\u064A (Kd) \u0639\u0644\u0649
        \u0642\u062F\u0631\u0629 \u0627\u0644\u0646\u0638\u0627\u0645 \u0639\u0644\u0649
        \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u062A\u0648\u0649
        \u0627\u0644\u0645\u0637\u0644\u0648\u0628 \u0648\u0627\u0644\u062D\u0641\u0627\u0638
        \u0639\u0644\u064A\u0647. \u0647\u0630\u0647 \u0627\u0644\u062A\u062C\u0631\u0628\u0629
        \u062A\u064F\u0638\u0647\u0631 \u0627\u0644\u062A\u062D\u0643\u0645 \u0628\u0627\u0644\u062A\u063A\u0630\u064A\u0629
        \u0627\u0644\u0631\u0627\u062C\u0639\u0629 \u0641\u064A \u062D\u0644\u0642\u0629
        \u0645\u063A\u0644\u0642\u0629 \u0643\u0645\u0627 \u0647\u0648 \u0645\u0637\u0628\u0642
        \u0641\u064A \u0627\u0644\u0639\u0645\u0644\u064A\u0627\u062A \u0627\u0644\u0635\u0646\u0627\u0639\u064A\u0629
        \u0627\u0644\u062D\u0642\u064A\u0642\u064A\u0629. "
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Objectives
      value: "\u062A\u0647\u062F\u0641 \u0647\u0630\u0647 \u0627\u0644\u062A\u062C\u0631\u0628\u0629
        \u0625\u0644\u0649 \u0641\u0647\u0645 \u0645\u0628\u0627\u062F\u0626 \u0627\u0644\u062A\u062D\u0643\u0645
        PID \u0645\u0646 \u062E\u0644\u0627\u0644 \u0636\u0628\u0637 \u0645\u0639\u0627\u0645\u0644\u0627\u062A
        Kp \u0648Ki \u0648Kd \u0644\u0636\u0628\u0637 \u0645\u0633\u062A\u0648\u0649
        \u0627\u0644\u0633\u0627\u0626\u0644 \u0641\u064A \u0627\u0644\u062E\u0632\u0627\u0646.
        \u0633\u062A\u0642\u0648\u0645 \u0628\u062A\u062D\u0644\u064A\u0644 \u062A\u0623\u062B\u064A\u0631
        \u0643\u0644 \u0645\u0639\u0627\u0645\u0644 \u0639\u0644\u0649 \u0632\u0645\u0646
        \u0627\u0644\u0627\u0631\u062A\u0641\u0627\u0639\u060C \u0648\u0627\u0644\u062A\u062E\u0637\u064A\u060C
        \u0648\u0632\u0645\u0646 \u0627\u0644\u0627\u0633\u062A\u0642\u0631\u0627\u0631\u060C
        \u0648\u0627\u0644\u062E\u0637\u0623 \u0627\u0644\u062B\u0627\u0628\u062A."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pull_Emergency
      value: "\u0642\u0645 \u0628\u0625\u0637\u0644\u0627\u0642 \u0645\u0641\u062A\u0627\u062D
        \u0627\u0644\u0637\u0648\u0627\u0631\u0626"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Switch_On
      value: "\u0627\u0636\u063A\u0637 \u0639\u0644\u0649 \u0645\u0641\u062A\u0627\u062D
        \u0627\u0644\u062A\u0634\u063A\u064A\u0644/\u0627\u0644\u0625\u064A\u0642\u0627\u0641
        \u0644\u0644\u0646\u0645\u0648\u0630\u062C."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Set_Gains_01
      value: "\u0639\u064A\u0651\u0646 \u0643\u0644\u0627 \u0645\u0646: (Kp)\u0639\u0644\u0649
