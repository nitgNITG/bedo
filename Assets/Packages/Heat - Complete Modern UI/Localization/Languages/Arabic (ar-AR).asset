      spriteValue: {fileID: 0}
    - key: Set_Pump_02
      value: "\u0642\u0645 \u0628\u0636\u0628\u0637 \u0645\u0639\u062F\u0644 \u0627\u0644\u062A\u062F\u0641\u0642
