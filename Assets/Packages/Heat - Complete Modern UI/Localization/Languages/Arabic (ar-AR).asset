      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pop_up_Quiz_02
      value: "\u064A\u0624\u062F\u064A \u0632\u064A\u0627\u062F\u0629 Kd \u0639\u0627\u062F\u0629\u064B
        \u0625\u0644\u0649:"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Notification_01
      value: "\u0645\u0644\u0627\u062D\u0638\u0629: \u0631\u0627\u0642\u0628 \u0627\u0633\u062A\u062C\u0627\u0628\u0629
