  - table: {fileID: 11400000, guid: 79d83ad8001512f45ab2a0b51a37cd86, type: 2}
    tableContent:
    - key: Title
      value: "\u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A \u0627\u0644\u062D\u0631\u0627\u0631\u0629
        \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0646\u0638\u0627\u0645
        \u0627\u0644\u062A\u062D\u0643\u0645 \u0630\u0648 \u0627\u0644\u062D\u0644\u0642\u0629
        \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629\r\n(\u0627\u0644\u0648\u0636\u0639
        \u0627\u0644\u064A\u062F\u0648\u064A) \r\n"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Title_Header
      value: "\u062A\u062C\u0631\u0628\u0629 2"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Instructor
      value: "\u0645\u0631\u062D\u0628\u0627\u064B! \u0641\u064A \u0647\u0630\u0647
        \u0627\u0644\u062A\u062C\u0631\u0628\u0629\u060C \u0633\u062A\u062A\u0639\u0644\u0645
        \u0643\u064A\u0641 \u064A\u0639\u0645\u0644 \u0627\u0644\u062A\u062D\u0643\u0645
        \u0641\u064A \u062F\u0631\u062C\u0629 \u0627\u0644\u062D\u0631\u0627\u0631\u0629
        \u0641\u064A \u0627\u0644\u062D\u0644\u0642\u0629 \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629
        \u0628\u062F\u0648\u0646 \u062A\u0635\u062D\u064A\u062D \u0628\u0627\u0644\u062A\u063A\u0630\u064A\u0629
        \u0627\u0644\u0645\u0631\u062A\u062F\u0629. \u0633\u062A\u0642\u0648\u0645
        \u0628\u0636\u0628\u0637 \u0637\u0627\u0642\u0629 \u0628\u0644\u062A\u064A\u064A\u0631
        \u064A\u062F\u0648\u064A\u0627\u064B \u0648\u0633\u062A\u0631\u0627\u0642\u0628
        \u0643\u064A\u0641\u064A\u0629 \u0627\u0633\u062A\u062C\u0627\u0628\u0629
        \u0627\u0644\u0646\u0638\u0627\u0645 \u0644\u0645\u062F\u062E\u0644\u0627\u062A\u0643
        \u0648\u0627\u0644\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062A \u0627\u0644\u062E\u0627\u0631\u062C\u064A\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Objectives
      value: "\u062A\u0647\u062F\u0641 \u0647\u0630\u0647 \u0627\u0644\u062A\u062C\u0631\u0628\u0629
        \u0625\u0644\u0649 \u062F\u0631\u0627\u0633\u0629 \u0633\u0644\u0648\u0643
        \u0639\u0645\u0644\u064A\u0629 \u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A
        \u062F\u0631\u062C\u0629 \u0627\u0644\u062D\u0631\u0627\u0631\u0629 \u0627\u0644\u062A\u064A
        \u062A\u0639\u0645\u0644 \u0641\u064A \u0648\u0636\u0639 \u0627\u0644\u062D\u0644\u0642\u0629
        \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629 \u0648\u0641\u0647\u0645
        \u062A\u0623\u062B\u064A\u0631 \u0645\u062F\u062E\u0644\u0627\u062A \u0627\u0644\u0645\u0634\u063A\u0644
        \u0639\u0644\u0649 \u062F\u0631\u062C\u0629 \u0627\u0644\u062D\u0631\u0627\u0631\u0629
        \u062F\u0648\u0646 \u062A\u0635\u062D\u064A\u062D \u0628\u0627\u0644\u062A\u063A\u0630\u064A\u0629
        \u0627\u0644\u0645\u0631\u062A\u062F\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Pull_Emergency
      value: "\u0642\u0645 \u0628\u062A\u062D\u0631\u064A\u0631 \u0645\u0641\u062A\u0627\u062D
        \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0645\u0648\u062C\u0648\u062F
        \u0639\u0644\u0649 \u0627\u0644\u062C\u0647\u0627\u0632."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Switch_On
      value: "\u0642\u0645 \u0628\u062A\u0634\u063A\u064A\u0644 \u0645\u0641\u062A\u0627\u062D
        \u0627\u0644\u062A\u0634\u063A\u064A\u0644/\u0627\u0644\u0625\u064A\u0642\u0627\u0641."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Manual_Mode_Button
      value: "\u0642\u0645 \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649
        \u0632\u0631 \"Open-Loop Mode\u201D \u0644\u062A\u0639\u0637\u064A\u0644
        PID \u0648\u0627\u0644\u062F\u062E\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u062A\u062D\u0643\u0645
        \u0628\u0627\u0644\u062D\u0644\u0642\u0629 \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Use_PowerAndTemp_Mode
      value: "\u0642\u0645 \u0628\u062A\u0641\u0639\u064A\u0644 \u0627\u0644\u0645\u0641\u062A\u0627\u062D
        \u0641\u064A \u0627\u062A\u062C\u0627\u0647 \u062F\u0631\u062C\u0629 \u0627\u0644\u062D\u0631\u0627\u0631\u0629."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SetTemp_01
      value: "\u0642\u0645 \u0628\u0636\u0628\u0637 \u0627\u0644\u0636\u063A\u0637
