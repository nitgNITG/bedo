  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A streamline is a curve tangent to the flow field everywhere. Intuitively,
    a streamline is the path that a massless particle (The ink) will follow if released
    in a laminar flow field. \r\n\nFor example, if a small shape is placed into a
    water flow path, and assuming the water flow does not change over time (i.e.,
    laminar flow), the trajectory of the shape is a streamline.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
