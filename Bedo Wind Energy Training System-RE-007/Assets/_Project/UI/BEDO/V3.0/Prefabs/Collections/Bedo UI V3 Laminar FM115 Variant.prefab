  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: Sink flow is the opposite of source flow. The streamlines are radial, directed
    inwards to the line source. As we get closer to the sink, area of flow decreases.
    In order to satisfy the continuity equation, the streamlines get bunched closer
    and the velocity increases as we get closer to the source.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
